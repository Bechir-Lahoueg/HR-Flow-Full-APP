                                        <Label text="💨" style="-fx-font-size: 14px;"/>
                                        <Label fx:id="weatherWindLabel" text="— km/h"
                                               style="-fx-font-size: 11px; -fx-text-fill: rgba(255,255,255,0.6);"/>
                                    </VBox>
                                    <VBox alignment="CENTER" spacing="2">
                                        <Label text="🌡" style="-fx-font-size: 14px;"/>
                                        <Label fx:id="weatherFeelsLabel" text="—°C"
                                               style="-fx-font-size: 11px; -fx-text-fill: rgba(255,255,255,0.6);"/>
                                    </VBox>
                                </HBox>
                            </VBox>
                        </HBox>
                        <HBox fx:id="forecastBox" spacing="8" alignment="CENTER"/>
                    </VBox>

                    <!-- Taux de change TND -->
                    <VBox spacing="14" minWidth="240"
                          style="-fx-background-color: white; -fx-background-radius: 20;
                                 -fx-border-color: #e5e7eb; -fx-border-width: 1.5; -fx-border-radius: 20;
                                 -fx-padding: 22;
                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.07), 12, 0, 0, 3);">
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label text="💱" style="-fx-font-size: 18px;"/>
                            <Label text="Taux TND" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>
                        </HBox>
                        <VBox fx:id="ratesBox" spacing="10"/>
                    </VBox>
                </HBox>
            </VBox>

            <!-- ══════════════════════════════════════════════════════ -->
            <!--  ACTUALITÉS + JOURS FÉRIÉS + CITATION                  -->
            <!-- ══════════════════════════════════════════════════════ -->
            <HBox spacing="18">
                <VBox spacing="14" HBox.hgrow="ALWAYS"
                      style="-fx-background-color: white; -fx-background-radius: 20;
                             -fx-border-color: #e5e7eb; -fx-border-width: 1.5; -fx-border-radius: 20;
                             -fx-padding: 22;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 12, 0, 0, 3);">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="📰" style="-fx-font-size: 18px;"/>
                        <Label text="Actualités RH" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>
                    </HBox>
                    <VBox fx:id="newsBox" spacing="12"/>
                </VBox>

                <VBox spacing="14" minWidth="280">
                    <!-- Jours fériés — gradient Formation -->
                    <VBox spacing="12"
                          style="-fx-background-color: linear-gradient(to bottom right, #022E69, #145EB7);
                                 -fx-background-radius: 20;
                                 -fx-padding: 22;
                                 -fx-effect: dropshadow(gaussian, rgba(2,46,105,0.25), 14, 0, 0, 4);">
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label text="🗓" style="-fx-font-size: 18px;"/>
                            <Label text="Prochains jours fériés"
                                   style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                        </HBox>
                        <VBox fx:id="holidaysBox" spacing="8"/>
                    </VBox>

                    <!-- Citation -->
                    <VBox spacing="10"
                          style="-fx-background-color: #fafafa; -fx-background-radius: 20;
                                 -fx-border-color: #e5e7eb; -fx-border-width: 1.5; -fx-border-radius: 20;
                                 -fx-padding: 20;
                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 10, 0, 0, 2);">
                        <Label text="💡 Citation du jour"
                               style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #6b7280;"/>
                        <Label fx:id="quoteLabel" text="—"
                               wrapText="true"
                               style="-fx-font-size: 13px; -fx-text-fill: #1f2937; -fx-font-style: italic;"/>
                        <Label fx:id="quoteAuthorLabel" text=""
                               style="-fx-font-size: 11px; -fx-text-fill: #9ca3af;"/>
                    </VBox>
                </VBox>
            </HBox>

        </VBox>
    </ScrollPane>
</StackPane>
