                                             -fx-min-width: 110;">
                                    <Label text="🇪🇺 EUR" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #0369a1;"/>
                                    <Label fx:id="lblConversionEUR" text="—" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #0c4a6e;"/>
                                </VBox>

                                <VBox spacing="6" alignment="CENTER"
                                      style="-fx-background-color: #f0f9ff; -fx-padding: 12; -fx-background-radius: 8;
                                             -fx-border-color: #bae6fd; -fx-border-width: 1; -fx-border-radius: 8;
                                             -fx-min-width: 110;">
                                    <Label text="🇺🇸 USD" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #0369a1;"/>
                                    <Label fx:id="lblConversionUSD" text="—" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #0c4a6e;"/>
                                </VBox>
                            </HBox>

                            <Label fx:id="lblApiStatus" text="✅ API connectée"
                                   style="-fx-font-size: 10px; -fx-text-fill: #14532d; -fx-background-color: #dcfce7; -fx-padding: 5 8; -fx-background-radius: 5;"/>
                        </VBox>

                        <!-- Taux du jour — style hero bleu marine -->
                        <HBox spacing="15" alignment="CENTER"
                              style="-fx-background-color: linear-gradient(to bottom right, #022E69, #0a3d8f, #051f3d);
                                     -fx-padding: 16; -fx-background-radius: 10;">
                            <VBox spacing="4" alignment="CENTER"
                                  style="-fx-background-color: rgba(255,255,255,0.08); -fx-padding: 12;
                                         -fx-background-radius: 8; -fx-border-color: rgba(255,255,255,0.15);
                                         -fx-border-width: 1; -fx-border-radius: 8;"
                                  HBox.hgrow="ALWAYS">
                                <Label text="EUR" style="-fx-font-size: 11px; -fx-text-fill: rgba(63,169,245,0.8);"/>
                                <Label fx:id="lblTauxEUR" text="0.290 €" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                            </VBox>

                            <VBox spacing="4" alignment="CENTER"
                                  style="-fx-background-color: rgba(255,255,255,0.08); -fx-padding: 12;
                                         -fx-background-radius: 8; -fx-border-color: rgba(255,255,255,0.15);
                                         -fx-border-width: 1; -fx-border-radius: 8;"
                                  HBox.hgrow="ALWAYS">
                                <Label text="USD" style="-fx-font-size: 11px; -fx-text-fill: rgba(63,169,245,0.8);"/>
                                <Label fx:id="lblTauxUSD" text="0.320 $" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;"/>
