<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<ScrollPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.ui.controller.Rh.RHRemunerationController"
            fitToWidth="true"
            style="-fx-background-color: #f4f7fb; -fx-background: #f4f7fb;">

    <VBox spacing="0" style="-fx-background-color: #f4f7fb;">

        <!-- ===== EN-TÊTE  (style Formation : gradient bleu foncé) ===== -->
        <VBox style="-fx-background-color: linear-gradient(to bottom right, #022E69, #0a3d8f, #051f3d);
                     -fx-padding: 28 32 28 32;">
            <HBox alignment="CENTER_LEFT" spacing="16">

                <!-- Titre + sous-titre -->
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Label text="● RH Control Center"
                               style="-fx-text-fill: #3FA9F5; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                    </HBox>
                    <Label text="Gestion de la Rémunération"
                           style="-fx-text-fill: white; -fx-font-size: 28px; -fx-font-weight: bold;"/>
                    <Label text="Gérez les fiches de paie, les primes, les déductions et la conversion de devises."
                           style="-fx-text-fill: #94a3b8; -fx-font-size: 13px;" wrapText="true"/>
                </VBox>

                <!-- Stats cards dans le hero -->
                <HBox spacing="12">

                    <!-- Total Fiches -->
                    <VBox style="-fx-background-color: rgba(255,255,255,0.08);
                                 -fx-border-color: rgba(255,255,255,0.15); -fx-border-radius: 10;
                                 -fx-background-radius: 10; -fx-border-width: 1; -fx-padding: 14 18;">
                        <Label text="TOTAL FICHES"
                               style="-fx-text-fill: rgba(63,169,245,0.7); -fx-font-size: 9px; -fx-font-weight: bold;"/>
                        <Label fx:id="lblTotalFiches" text="0"
                               style="-fx-text-fill: white; -fx-font-size: 28px; -fx-font-weight: bold;"/>
                        <Label text="de paie"
                               style="-fx-text-fill: rgba(63,169,245,0.6); -fx-font-size: 10px;"/>
                    </VBox>

                    <!-- Total Primes -->
                    <VBox style="-fx-background-color: rgba(255,255,255,0.08);
                                 -fx-border-color: rgba(255,255,255,0.15); -fx-border-radius: 10;
                                 -fx-background-radius: 10; -fx-border-width: 1; -fx-padding: 14 18;">
                        <Label text="TOTAL PRIMES"
                               style="-fx-text-fill: rgba(63,169,245,0.7); -fx-font-size: 9px; -fx-font-weight: bold;"/>
                        <Label fx:id="lblTotalPrimesHero" text="0 DT"
                               style="-fx-text-fill: #f59e0b; -fx-font-size: 28px; -fx-font-weight: bold;"/>
                        <Label text="accordées"
                               style="-fx-text-fill: rgba(63,169,245,0.6); -fx-font-size: 10px;"/>
                    </VBox>

                    <!-- Total Déductions -->
                    <VBox style="-fx-background-color: rgba(255,255,255,0.08);
                                 -fx-border-color: rgba(255,255,255,0.15); -fx-border-radius: 10;
                                 -fx-background-radius: 10; -fx-border-width: 1; -fx-padding: 14 18;">
                        <Label text="DÉDUCTIONS"
                               style="-fx-text-fill: rgba(63,169,245,0.7); -fx-font-size: 9px; -fx-font-weight: bold;"/>
                        <Label fx:id="lblTotalDeductionsHero" text="0 DT"
                               style="-fx-text-fill: #f87171; -fx-font-size: 28px; -fx-font-weight: bold;"/>
                        <Label text="retenues"
                               style="-fx-text-fill: rgba(63,169,245,0.6); -fx-font-size: 10px;"/>
                    </VBox>

                    <!-- Masse Salariale -->
                    <VBox style="-fx-background-color: rgba(255,255,255,0.08);
                                 -fx-border-color: rgba(255,255,255,0.15); -fx-border-radius: 10;
                                 -fx-background-radius: 10; -fx-border-width: 1; -fx-padding: 14 18;">
                        <Label text="MASSE SALARIALE"
                               style="-fx-text-fill: rgba(63,169,245,0.7); -fx-font-size: 9px; -fx-font-weight: bold;"/>
                        <Label fx:id="lblMasseSalarialeHero" text="0 DT"
                               style="-fx-text-fill: white; -fx-font-size: 28px; -fx-font-weight: bold;"/>
                        <Label text="au total"
                               style="-fx-text-fill: rgba(63,169,245,0.6); -fx-font-size: 10px;"/>
                    </VBox>

                </HBox>

                <!-- Boutons action -->
                <VBox spacing="8" alignment="CENTER_RIGHT">
                    <Button fx:id="btnGenerateFiche" text="⚡ Générer Auto"
                            onAction="#handleGenerateFiche"
                            style="-fx-background-color: rgba(255,255,255,0.10);
                                   -fx-text-fill: white; -fx-font-size: 12px; -fx-font-weight: bold;
                                   -fx-padding: 9 18; -fx-background-radius: 8; -fx-cursor: hand;
                                   -fx-border-color: rgba(255,255,255,0.30); -fx-border-width: 1;
                                   -fx-border-radius: 8;">
                        <font><Font name="System Bold" size="12.0"/></font>
                    </Button>
                    <Button fx:id="refreshButton" text="🔄 Actualiser"
                            style="-fx-background-color: rgba(255,255,255,0.10);
                                   -fx-text-fill: white; -fx-font-size: 12px; -fx-font-weight: bold;
                                   -fx-padding: 9 18; -fx-background-radius: 8; -fx-cursor: hand;
                                   -fx-border-color: rgba(255,255,255,0.30); -fx-border-width: 1;
                                   -fx-border-radius: 8;">
                        <font><Font name="System Bold" size="12.0"/></font>
                    </Button>
                </VBox>

            </HBox>
        </VBox>

        <!-- ===== STATISTIQUES (cartes blanches, style Formation) ===== -->
        <HBox spacing="16" style="-fx-padding: 20 32 0 32;">

            <!-- Total Fiches -->
            <VBox spacing="6" HBox.hgrow="ALWAYS"
                  style="-fx-background-color: white; -fx-border-radius: 12; -fx-background-radius: 12;
                         -fx-border-color: #e2e8f0; -fx-border-width: 1; -fx-padding: 18;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <VBox style="-fx-background-color: rgba(20,94,183,0.10); -fx-background-radius: 8;
                                 -fx-padding: 8;">
                        <Label text="💵" style="-fx-font-size: 16px;"/>
                    </VBox>
                    <Label text="Total" style="-fx-font-size: 11px; -fx-font-weight: bold;
                                               -fx-text-fill: #022E69;
                                               -fx-background-color: rgba(20,94,183,0.10);
                                               -fx-background-radius: 5; -fx-padding: 3 7;"/>
                </HBox>
                <Label fx:id="lblTotalFiches" text="0"
                       style="-fx-font-size: 30px; -fx-font-weight: bold; -fx-text-fill: #1a202c;"/>
                <Label text="Fiches de Paie"
                       style="-fx-font-size: 12px; -fx-text-fill: #94a3b8; -fx-font-weight: bold;"/>
                <Region prefHeight="4" style="-fx-background-color: linear-gradient(to right, #145EB7, #3FA9F5);
                                              -fx-background-radius: 2;"/>
            </VBox>

            <!-- Total Primes -->
            <VBox spacing="6" HBox.hgrow="ALWAYS"
                  style="-fx-background-color: white; -fx-border-radius: 12; -fx-background-radius: 12;
                         -fx-border-color: #e2e8f0; -fx-border-width: 1; -fx-padding: 18;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <VBox style="-fx-background-color: #dcfce7; -fx-background-radius: 8; -fx-padding: 8;">
                        <Label text="🎁" style="-fx-font-size: 16px;"/>
                    </VBox>
                </HBox>
                <Label fx:id="lblTotalPrimes" text="0 DT"
                       style="-fx-font-size: 30px; -fx-font-weight: bold; -fx-text-fill: #16a34a;"/>
                <Label text="Total Primes"
                       style="-fx-font-size: 12px; -fx-text-fill: #94a3b8; -fx-font-weight: bold;"/>
                <Region prefHeight="4" style="-fx-background-color: linear-gradient(to right, #22c55e, #14b8a6);
                                              -fx-background-radius: 2;"/>
            </VBox>

            <!-- Total Déductions -->
            <VBox spacing="6" HBox.hgrow="ALWAYS"
                  style="-fx-background-color: white; -fx-border-radius: 12; -fx-background-radius: 12;
                         -fx-border-color: #e2e8f0; -fx-border-width: 1; -fx-padding: 18;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <VBox style="-fx-background-color: #fee2e2; -fx-background-radius: 8; -fx-padding: 8;">
                        <Label text="📉" style="-fx-font-size: 16px;"/>
                    </VBox>
                </HBox>
                <Label fx:id="lblTotalDeductions" text="0 DT"
                       style="-fx-font-size: 30px; -fx-font-weight: bold; -fx-text-fill: #dc2626;"/>
                <Label text="Total Déductions"
                       style="-fx-font-size: 12px; -fx-text-fill: #94a3b8; -fx-font-weight: bold;"/>
                <Region prefHeight="4" style="-fx-background-color: linear-gradient(to right, #ef4444, #f97316);
                                              -fx-background-radius: 2;"/>
            </VBox>

            <!-- Masse Salariale -->
            <VBox spacing="6" HBox.hgrow="ALWAYS"
                  style="-fx-background-color: white; -fx-border-radius: 12; -fx-background-radius: 12;
                         -fx-border-color: #e2e8f0; -fx-border-width: 1; -fx-padding: 18;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <VBox style="-fx-background-color: #fef3c7; -fx-background-radius: 8; -fx-padding: 8;">
                        <Label text="💰" style="-fx-font-size: 16px;"/>
                    </VBox>
                </HBox>
                <Label fx:id="lblMasseSalariale" text="0 DT"
                       style="-fx-font-size: 30px; -fx-font-weight: bold; -fx-text-fill: #d97706;"/>
                <Label text="Masse Salariale"
                       style="-fx-font-size: 12px; -fx-text-fill: #94a3b8; -fx-font-weight: bold;"/>
                <Region prefHeight="4" style="-fx-background-color: linear-gradient(to right, #f59e0b, #fb923c);
                                              -fx-background-radius: 2;"/>
            </VBox>

        </HBox>

        <!-- ===== TABS ===== -->
        <VBox style="-fx-padding: 20 32 0 32;">
            <TabPane fx:id="tabPane" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS"
                     style="-fx-background-color: white; -fx-background-radius: 12;
                            -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);
                            -fx-border-color: #e2e8f0; -fx-border-width: 1; -fx-border-radius: 12;">

                <!-- Tab 1: Fiches de Paie -->
                <Tab text="📄 Fiches de Paie">
                    <VBox spacing="12" style="-fx-padding: 20;">
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label text="📊 Fiches de Paie" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #022E69;"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <TextField fx:id="txtSearchFiche" promptText="🔍 Rechercher..." prefWidth="180"
                                       style="-fx-font-size: 12px; -fx-padding: 6 10; -fx-background-radius: 6; -fx-border-color: #e2e8f0; -fx-border-radius: 6;"/>
                            <Button fx:id="btnRefreshFiches" text="🔄" onAction="#handleRefreshFiches"
                                    style="-fx-background-color: #f1f5f9; -fx-text-fill: #145EB7; -fx-font-size: 13px; -fx-padding: 6 10; -fx-background-radius: 6; -fx-cursor: hand; -fx-border-color: #e2e8f0; -fx-border-width: 1; -fx-border-radius: 6;"/>
                        </HBox>

                        <Separator style="-fx-background-color: #f1f5f9;"/>

                        <TableView fx:id="tableFiches" VBox.vgrow="ALWAYS"
                                   style="-fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-width: 1; -fx-border-radius: 8;">
                            <columns>
                                <TableColumn fx:id="colFicheId" text="ID" prefWidth="0.05" style="-fx-alignment: CENTER;"/>
                                <TableColumn fx:id="colFicheEmploye" text="Employé" prefWidth="0.20"/>
                                <TableColumn fx:id="colFicheMois" text="Mois" prefWidth="0.10" style="-fx-alignment: CENTER;"/>
                                <TableColumn fx:id="colFicheAnnee" text="Année" prefWidth="0.08" style="-fx-alignment: CENTER;"/>
                                <TableColumn fx:id="colFicheSalaireBrut" text="Brut" prefWidth="0.12" style="-fx-alignment: CENTER_RIGHT;"/>
                                <TableColumn fx:id="colFicheTotalPrimes" text="Primes" prefWidth="0.12" style="-fx-alignment: CENTER_RIGHT;"/>
                                <TableColumn fx:id="colFicheTotalDeductions" text="Déductions" prefWidth="0.11" style="-fx-alignment: CENTER_RIGHT;"/>
                                <TableColumn fx:id="colFicheSalaireNet" text="Net" prefWidth="0.12" style="-fx-alignment: CENTER_RIGHT;"/>
                                <TableColumn fx:id="colFicheStatut" text="Statut" prefWidth="0.09" style="-fx-alignment: CENTER;"/>
                            </columns>
                            <placeholder>
                                <VBox alignment="CENTER" spacing="8" style="-fx-padding: 30;">
                                    <Label text="📭" style="-fx-font-size: 40px; -fx-opacity: 0.3;"/>
                                    <Label text="Aucune fiche de paie" style="-fx-text-fill: #a0aec0; -fx-font-size: 14px;"/>
                                </VBox>
                            </placeholder>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>

                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Button fx:id="btnAddFiche" text="➕ Nouvelle" onAction="#handleAddFiche"
                                    style="-fx-background-color: linear-gradient(to right, #145EB7, #3FA9F5); -fx-text-fill: white; -fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 8 16; -fx-background-radius: 6; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(20,94,183,0.35), 6, 0, 0, 2);"/>
                            <Button fx:id="btnEditFiche" text="✏️ Modifier" onAction="#handleEditFiche"
                                    style="-fx-background-color: #fef3c7; -fx-text-fill: #92400e; -fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 8 16; -fx-background-radius: 6; -fx-cursor: hand; -fx-border-color: #f59e0b; -fx-border-width: 1; -fx-border-radius: 6;"/>
                            <Button fx:id="btnDeleteFiche" text="🗑️ Supprimer" onAction="#handleDeleteFiche"
                                    style="-fx-background-color: #fee2e2; -fx-text-fill: #991b1b; -fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 8 16; -fx-background-radius: 6; -fx-cursor: hand; -fx-border-color: #ef4444; -fx-border-width: 1; -fx-border-radius: 6;"/>
                            <Button fx:id="btnToggleStatut" text="✅ Basculer Statut" onAction="#handleToggleStatut"
                                    style="-fx-background-color: #dcfce7; -fx-text-fill: #14532d; -fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 8 16; -fx-background-radius: 6; -fx-cursor: hand; -fx-border-color: #22c55e; -fx-border-width: 1; -fx-border-radius: 6;"/>
                            <Separator orientation="VERTICAL"/>
                            <Button fx:id="btnGenerateFiche" text="⚡ Générer" onAction="#handleGenerateFiche"
                                    style="-fx-background-color: #022E69; -fx-text-fill: white; -fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 8 16; -fx-background-radius: 6; -fx-cursor: hand;"/>
                            <Button fx:id="btnExportPdfFiche" text="📄 PDF" onAction="#handleExportPdfFiche"
                                    style="-fx-background-color: #f1f5f9; -fx-text-fill: #145EB7; -fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 8 16; -fx-background-radius: 6; -fx-cursor: hand; -fx-border-color: #145EB7; -fx-border-width: 1; -fx-border-radius: 6;"/>
                        </HBox>
                    </VBox>
                </Tab>

                <!-- Tab 2: Primes -->
                <Tab text="🎁 Primes">
                    <VBox spacing="12" style="-fx-padding: 20;">
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label text="🎯 Gestion des Primes" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #022E69;"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <TextField fx:id="txtSearchPrime" promptText="🔍 Rechercher..." prefWidth="180"
                                       style="-fx-font-size: 12px; -fx-padding: 6 10; -fx-background-radius: 6; -fx-border-color: #e2e8f0; -fx-border-radius: 6;"/>
                            <Button fx:id="btnRefreshPrimes" text="🔄" onAction="#handleRefreshPrimes"
                                    style="-fx-background-color: #f1f5f9; -fx-text-fill: #145EB7; -fx-font-size: 13px; -fx-padding: 6 10; -fx-background-radius: 6; -fx-cursor: hand; -fx-border-color: #e2e8f0; -fx-border-width: 1; -fx-border-radius: 6;"/>
                        </HBox>

                        <Separator style="-fx-background-color: #f1f5f9;"/>

                        <TableView fx:id="tablePrimes" VBox.vgrow="ALWAYS"
                                   style="-fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-width: 1; -fx-border-radius: 8;">
                            <columns>
                                <TableColumn fx:id="colPrimeId" text="ID" prefWidth="0.06" style="-fx-alignment: CENTER;"/>
                                <TableColumn fx:id="colPrimeEmploye" text="Employé" prefWidth="0.30"/>
                                <TableColumn fx:id="colPrimeType" text="Type" prefWidth="0.32"/>
                                <TableColumn fx:id="colPrimeMontant" text="Montant" prefWidth="0.16" style="-fx-alignment: CENTER_RIGHT;"/>
                                <TableColumn fx:id="colPrimeDate" text="Date" prefWidth="0.16" style="-fx-alignment: CENTER;"/>
                            </columns>
                            <placeholder>
                                <VBox alignment="CENTER" spacing="8" style="-fx-padding: 30;">
                                    <Label text="🎁" style="-fx-font-size: 40px; -fx-opacity: 0.3;"/>
                                    <Label text="Aucune prime" style="-fx-text-fill: #a0aec0; -fx-font-size: 14px;"/>
                                </VBox>
                            </placeholder>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>

                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Button fx:id="btnAddPrime" text="➕ Nouvelle" onAction="#handleAddPrime"
                                    style="-fx-background-color: linear-gradient(to right, #145EB7, #3FA9F5); -fx-text-fill: white; -fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 8 16; -fx-background-radius: 6; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(20,94,183,0.35), 6, 0, 0, 2);"/>
                            <Button fx:id="btnEditPrime" text="✏️ Modifier" onAction="#handleEditPrime"
                                    style="-fx-background-color: #fef3c7; -fx-text-fill: #92400e; -fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 8 16; -fx-background-radius: 6; -fx-cursor: hand; -fx-border-color: #f59e0b; -fx-border-width: 1; -fx-border-radius: 6;"/>
                            <Button fx:id="btnDeletePrime" text="🗑️ Supprimer" onAction="#handleDeletePrime"
                                    style="-fx-background-color: #fee2e2; -fx-text-fill: #991b1b; -fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 8 16; -fx-background-radius: 6; -fx-cursor: hand; -fx-border-color: #ef4444; -fx-border-width: 1; -fx-border-radius: 6;"/>
                        </HBox>
                    </VBox>
                </Tab>

                <!-- Tab 3: Déductions -->
                <Tab text="📉 Déductions">
                    <VBox spacing="12" style="-fx-padding: 20;">
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label text="📊 Gestion des Déductions" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #022E69;"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <TextField fx:id="txtSearchDeduction" promptText="🔍 Rechercher..." prefWidth="180"
                                       style="-fx-font-size: 12px; -fx-padding: 6 10; -fx-background-radius: 6; -fx-border-color: #e2e8f0; -fx-border-radius: 6;"/>
                            <Button fx:id="btnRefreshDeductions" text="🔄" onAction="#handleRefreshDeductions"
                                    style="-fx-background-color: #f1f5f9; -fx-text-fill: #145EB7; -fx-font-size: 13px; -fx-padding: 6 10; -fx-background-radius: 6; -fx-cursor: hand; -fx-border-color: #e2e8f0; -fx-border-width: 1; -fx-border-radius: 6;"/>
                        </HBox>

                        <Separator style="-fx-background-color: #f1f5f9;"/>

                        <TableView fx:id="tableDeductions" VBox.vgrow="ALWAYS"
                                   style="-fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-width: 1; -fx-border-radius: 8;">
                            <columns>
                                <TableColumn fx:id="colDeductionId" text="ID" prefWidth="0.06" style="-fx-alignment: CENTER;"/>
                                <TableColumn fx:id="colDeductionEmploye" text="Employé" prefWidth="0.30"/>
                                <TableColumn fx:id="colDeductionType" text="Type" prefWidth="0.32"/>
                                <TableColumn fx:id="colDeductionMontant" text="Montant" prefWidth="0.16" style="-fx-alignment: CENTER_RIGHT;"/>
                                <TableColumn fx:id="colDeductionDate" text="Date" prefWidth="0.16" style="-fx-alignment: CENTER;"/>
                            </columns>
                            <placeholder>
                                <VBox alignment="CENTER" spacing="8" style="-fx-padding: 30;">
                                    <Label text="📉" style="-fx-font-size: 40px; -fx-opacity: 0.3;"/>
                                    <Label text="Aucune déduction" style="-fx-text-fill: #a0aec0; -fx-font-size: 14px;"/>
                                </VBox>
                            </placeholder>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>

                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Button fx:id="btnAddDeduction" text="➕ Nouvelle" onAction="#handleAddDeduction"
                                    style="-fx-background-color: linear-gradient(to right, #145EB7, #3FA9F5); -fx-text-fill: white; -fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 8 16; -fx-background-radius: 6; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(20,94,183,0.35), 6, 0, 0, 2);"/>
                            <Button fx:id="btnEditDeduction" text="✏️ Modifier" onAction="#handleEditDeduction"
                                    style="-fx-background-color: #fef3c7; -fx-text-fill: #92400e; -fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 8 16; -fx-background-radius: 6; -fx-cursor: hand; -fx-border-color: #f59e0b; -fx-border-width: 1; -fx-border-radius: 6;"/>
                            <Button fx:id="btnDeleteDeduction" text="🗑️ Supprimer" onAction="#handleDeleteDeduction"
