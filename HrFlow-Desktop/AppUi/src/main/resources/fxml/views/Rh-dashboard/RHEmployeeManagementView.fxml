<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<ScrollPane fitToWidth="true" fitToHeight="true" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.ui.controller.Rh.RHEmployeeManagementViewController"
            style="-fx-background-color: transparent; -fx-background: transparent;">

    <VBox spacing="0" minHeight="700" style="-fx-background-color: #f4f7fb;">

        <!-- ═══════════════════════════════════════════════════════
             HERO BANNER  (gradient Formation #022E69 → #0a3d8f → #051f3d)
        ═══════════════════════════════════════════════════════ -->
        <VBox style="-fx-background-color: linear-gradient(to bottom right, #022E69, #0a3d8f, #051f3d);
                     -fx-padding: 28 32 28 32;">
            <HBox alignment="CENTER_LEFT" spacing="16">
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Label text="● RH Control Center"
                               style="-fx-text-fill: #3FA9F5; -fx-font-size: 11px; -fx-font-weight: bold;">
                            <font><Font name="System Bold" size="11.0"/></font>
                        </Label>
                    </HBox>
                    <Label text="Gestion des Employés"
                           style="-fx-text-fill: white; -fx-font-size: 28px; -fx-font-weight: bold;">
                        <font><Font name="System Bold" size="28.0"/></font>
                    </Label>
                    <Label text="Consultez, ajoutez et gérez les profils de vos employés."
                           style="-fx-text-fill: #94a3b8; -fx-font-size: 13px;" wrapText="true"/>
                </VBox>

                <!-- Stats cards dans le hero -->
                <HBox spacing="12">
                    <VBox style="-fx-background-color: rgba(255,255,255,0.08);
                                 -fx-border-color: rgba(255,255,255,0.15); -fx-border-radius: 10;
                                 -fx-background-radius: 10; -fx-border-width: 1; -fx-padding: 14 18;">
                        <Label text="TOTAL EMPLOYÉS"
                               style="-fx-text-fill: rgba(63,169,245,0.7); -fx-font-size: 9px; -fx-font-weight: bold;">
                            <font><Font name="System Bold" size="9.0"/></font>
                        </Label>
                        <Label fx:id="totalEmployeesLabel" text="0"
                               style="-fx-text-fill: white; -fx-font-size: 28px; -fx-font-weight: bold;">
                            <font><Font name="System Bold" size="28.0"/></font>
                        </Label>
                        <Label text="dans l'équipe"
                               style="-fx-text-fill: rgba(63,169,245,0.6); -fx-font-size: 10px;"/>
                    </VBox>
                    <VBox style="-fx-background-color: rgba(255,255,255,0.08);
                                 -fx-border-color: rgba(255,255,255,0.15); -fx-border-radius: 10;
                                 -fx-background-radius: 10; -fx-border-width: 1; -fx-padding: 14 18;">
                        <Label text="ÂGE MOYEN"
                               style="-fx-text-fill: rgba(63,169,245,0.7); -fx-font-size: 9px; -fx-font-weight: bold;">
                            <font><Font name="System Bold" size="9.0"/></font>
                        </Label>
                        <Label fx:id="avgAgeLabel" text="0"
                               style="-fx-text-fill: #f59e0b; -fx-font-size: 28px; -fx-font-weight: bold;">
                            <font><Font name="System Bold" size="28.0"/></font>
                        </Label>
                        <Label text="ans"
                               style="-fx-text-fill: rgba(63,169,245,0.6); -fx-font-size: 10px;"/>
                    </VBox>
                    <VBox style="-fx-background-color: rgba(255,255,255,0.08);
                                 -fx-border-color: rgba(255,255,255,0.15); -fx-border-radius: 10;
                                 -fx-background-radius: 10; -fx-border-width: 1; -fx-padding: 14 18;">
                        <Label text="TYPES DE POSTES"
                               style="-fx-text-fill: rgba(63,169,245,0.7); -fx-font-size: 9px; -fx-font-weight: bold;">
                            <font><Font name="System Bold" size="9.0"/></font>
                        </Label>
                        <Label fx:id="jobTypesLabel" text="0"
                               style="-fx-text-fill: white; -fx-font-size: 28px; -fx-font-weight: bold;">
                            <font><Font name="System Bold" size="28.0"/></font>
                        </Label>
                        <Label text="postes distincts"
                               style="-fx-text-fill: rgba(63,169,245,0.6); -fx-font-size: 10px;"/>
                    </VBox>
                </HBox>
            </HBox>
        </VBox>

        <!-- ═══════════════════════════════════════════════════════
             STATS ROW  (3 cartes blanches)
        ═══════════════════════════════════════════════════════ -->
        <HBox spacing="16" style="-fx-padding: 20 32 0 32;">

            <!-- Carte Total Employés -->
            <VBox spacing="6" HBox.hgrow="ALWAYS"
                  style="-fx-background-color: white; -fx-border-radius: 12; -fx-background-radius: 12;
                         -fx-border-color: #e2e8f0; -fx-border-width: 1; -fx-padding: 18;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <VBox style="-fx-background-color: rgba(20,94,183,0.1); -fx-background-radius: 8;
                                 -fx-padding: 8;">
                        <Label text="👥" style="-fx-font-size: 16px;"/>
                    </VBox>
                    <Label text="Total" style="-fx-font-size: 11px; -fx-font-weight: bold;
                                               -fx-text-fill: #022E69;
                                               -fx-background-color: rgba(20,94,183,0.1);
                                               -fx-background-radius: 5; -fx-padding: 3 7;">
                        <font><Font name="System Bold" size="11.0"/></font>
                    </Label>
                </HBox>
                <Label fx:id="totalEmployeesLabel2" text="0"
                       style="-fx-font-size: 30px; -fx-font-weight: bold; -fx-text-fill: #1a202c;">
                    <font><Font name="System Bold" size="30.0"/></font>
                </Label>
                <Label text="Employés"
                       style="-fx-font-size: 12px; -fx-text-fill: #94a3b8; -fx-font-weight: bold;">
                    <font><Font name="System Bold" size="12.0"/></font>
                </Label>
                <Region prefHeight="4" style="-fx-background-color: linear-gradient(to right, #145EB7, #3FA9F5);
                                              -fx-background-radius: 2;"/>
            </VBox>

            <!-- Carte Âge Moyen -->
            <VBox spacing="6" HBox.hgrow="ALWAYS"
                  style="-fx-background-color: white; -fx-border-radius: 12; -fx-background-radius: 12;
                         -fx-border-color: #e2e8f0; -fx-border-width: 1; -fx-padding: 18;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <VBox style="-fx-background-color: #fef3c7; -fx-background-radius: 8; -fx-padding: 8;">
                        <Label text="📊" style="-fx-font-size: 16px;"/>
                    </VBox>
                </HBox>
                <Label fx:id="avgAgeLabel2" text="0"
                       style="-fx-font-size: 30px; -fx-font-weight: bold; -fx-text-fill: #d97706;">
                    <font><Font name="System Bold" size="30.0"/></font>
                </Label>
                <Label text="Âge Moyen"
                       style="-fx-font-size: 12px; -fx-text-fill: #94a3b8; -fx-font-weight: bold;">
                    <font><Font name="System Bold" size="12.0"/></font>
                </Label>
                <Region prefHeight="4" style="-fx-background-color: linear-gradient(to right, #f59e0b, #fb923c);
                                              -fx-background-radius: 2;"/>
            </VBox>

            <!-- Carte Types de Postes -->
            <VBox spacing="6" HBox.hgrow="ALWAYS"
                  style="-fx-background-color: white; -fx-border-radius: 12; -fx-background-radius: 12;
                         -fx-border-color: #e2e8f0; -fx-border-width: 1; -fx-padding: 18;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <VBox style="-fx-background-color: #dcfce7; -fx-background-radius: 8; -fx-padding: 8;">
                        <Label text="💼" style="-fx-font-size: 16px;"/>
                    </VBox>
                </HBox>
                <Label fx:id="jobTypesLabel2" text="0"
                       style="-fx-font-size: 30px; -fx-font-weight: bold; -fx-text-fill: #16a34a;">
                    <font><Font name="System Bold" size="30.0"/></font>
                </Label>
                <Label text="Types de Postes"
                       style="-fx-font-size: 12px; -fx-text-fill: #94a3b8; -fx-font-weight: bold;">
                    <font><Font name="System Bold" size="12.0"/></font>
                </Label>
                <Region prefHeight="4" style="-fx-background-color: linear-gradient(to right, #22c55e, #14b8a6);
                                              -fx-background-radius: 2;"/>
            </VBox>

        </HBox>

        <!-- ═══════════════════════════════════════════════════════
             TABLE SECTION
        ═══════════════════════════════════════════════════════ -->
        <VBox spacing="0" style="-fx-padding: 20 32 32 32;">

            <!-- Toolbar -->
            <HBox style="-fx-background-color: white; -fx-border-color: #e2e8f0;
                         -fx-border-width: 0 0 2 0; -fx-background-radius: 12 12 0 0;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.04), 4, 0, 0, 1);
                         -fx-padding: 0 16;">
                <Button text="➕  Ajouter un Employé" onAction="#handleAddEmployee"
                        style="-fx-background-color: linear-gradient(to right, #145EB7, #3FA9F5);
                               -fx-text-fill: white; -fx-padding: 14 22; -fx-cursor: hand;
                               -fx-font-weight: bold; -fx-font-size: 13px;
                               -fx-effect: dropshadow(gaussian, rgba(20,94,183,0.35), 6, 0, 0, 2);
                               -fx-background-radius: 0; -fx-border-color: transparent;">
                    <font><Font name="System Bold" size="13.0"/></font>
                </Button>
                <Region HBox.hgrow="ALWAYS"/>
                <HBox alignment="CENTER" spacing="10" style="-fx-padding: 10 0;">
                    <TextField fx:id="searchField" promptText="🔍 Rechercher..."
                               prefWidth="280" prefHeight="34"
                               style="-fx-background-color: white; -fx-border-color: #e2e8f0;
                                      -fx-border-radius: 6; -fx-background-radius: 6;
                                      -fx-padding: 0 12; -fx-font-size: 12px;"/>
                    <!-- Modifier -->
                    <Button text="✏️  Modifier" onAction="#handleEditEmployee"
                            style="-fx-background-color: #f0f6ff; -fx-text-fill: #145EB7;
                                   -fx-padding: 9 16; -fx-background-radius: 8; -fx-cursor: hand;
                                   -fx-font-weight: bold; -fx-font-size: 12px;
                                   -fx-border-color: #b5d4f4; -fx-border-width: 1; -fx-border-radius: 8;">
                        <font><Font name="System Bold" size="12.0"/></font>
                    </Button>
                    <!-- Supprimer -->
                    <Button text="🗑️  Supprimer" onAction="#handleDeleteEmployee"
                            style="-fx-background-color: #fff1f2; -fx-text-fill: #dc2626;
                                   -fx-padding: 9 16; -fx-background-radius: 8; -fx-cursor: hand;
                                   -fx-font-weight: bold; -fx-font-size: 12px;
                                   -fx-border-color: #fecdd3; -fx-border-width: 1; -fx-border-radius: 8;">
                        <font><Font name="System Bold" size="12.0"/></font>
                    </Button>
                </HBox>
            </HBox>

            <!-- Table container -->
            <VBox VBox.vgrow="ALWAYS"
                  style="-fx-background-color: white;
                         -fx-border-color: #e2e8f0; -fx-border-width: 0 1 1 1;
                         -fx-background-radius: 0 0 12 12;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);
                         -fx-padding: 0 16 20 16;">

                <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 16 0 12 0;">
                    <Label text="📋 Liste des Employés"
                           style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1e293b;">
                        <font><Font name="System Bold" size="14.0"/></font>
                    </Label>
                </HBox>

                <Separator style="-fx-background-color: #f1f5f9;"/>

                <TableView fx:id="employeesTable" VBox.vgrow="ALWAYS" prefHeight="420" minHeight="320"
                           style="-fx-background-color: transparent; -fx-border-color: transparent;">
                    <columns>
                        <TableColumn fx:id="idColumn" text="ID" prefWidth="70.0" minWidth="60"/>
                        <TableColumn fx:id="firstNameColumn" text="Prénom" prefWidth="160.0" minWidth="120"/>
                        <TableColumn fx:id="lastNameColumn" text="Nom" prefWidth="160.0" minWidth="120"/>
                        <TableColumn fx:id="ageColumn" text="Âge" prefWidth="90.0" minWidth="70"/>
                        <TableColumn fx:id="jobTitleColumn" text="Poste" prefWidth="220.0" minWidth="180"/>
                        <TableColumn fx:id="emailColumn" text="Email" prefWidth="280.0" minWidth="220"/>
                        <TableColumn fx:id="actionsColumn" text="Actions" prefWidth="160.0" minWidth="130"/>
                    </columns>
                    <placeholder>
                        <Label text="Aucun employé pour le moment"
                               style="-fx-text-fill: #94a3b8; -fx-font-size: 13px;"/>
                    </placeholder>
                </TableView>
            </VBox>
        </VBox>

        <!-- Padding bas -->
        <Region prefHeight="24"/>

    </VBox>
</ScrollPane>
