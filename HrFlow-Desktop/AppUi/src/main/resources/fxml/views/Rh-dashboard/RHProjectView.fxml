<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>

<ScrollPane fitToWidth="true" xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.ui.controller.Rh.RHProjectController"
            style="-fx-background-color: #f4f7fb; -fx-background: #f4f7fb; -fx-border-color: transparent;">

    <VBox spacing="0" style="-fx-background-color: #f4f7fb;">

        <VBox spacing="25" style="-fx-padding: 25;">

            <VBox style="-fx-background-color: linear-gradient(to bottom right, #022E69, #0a3d8f, #051f3d); -fx-padding: 28 32 28 32;">
                <HBox alignment="CENTER_LEFT" spacing="20">
                    <StackPane style="-fx-background-color: rgba(255,255,255,0.2); -fx-background-radius: 12; -fx-padding: 12;">
                        <Label text="🎯" style="-fx-font-size: 28px;"/>
                    </StackPane>
                    <VBox>
                        <Label text="Gestion des Projets" style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 28px;"/>
                        <Label text="Pilotage stratégique et suivi opérationnel" style="-fx-text-fill: #94a3b8; -fx-font-size: 13px;"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="← Retour Dashboard" onAction="#handleBackToDashboard"
                            style="-fx-background-color: white; -fx-text-fill: #022E69;
                                   -fx-border-color: #bfdbfe; -fx-border-width: 1;
                                   -fx-border-radius: 8; -fx-background-radius: 8;
                                   -fx-padding: 8 16; -fx-cursor: hand;
                                   -fx-font-weight: bold; -fx-font-size: 12px;
                                   -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 6, 0, 0, 1);"/>
                </HBox>
            </VBox>

            <VBox spacing="15">
                <HBox spacing="16" alignment="CENTER">
                    <VBox spacing="6" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: white; -fx-border-radius: 12; -fx-background-radius: 12;
                                 -fx-border-color: #e2e8f0; -fx-border-width: 1; -fx-padding: 18;
                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);">
                        <Label text="TOTAL PROJETS" style="-fx-text-fill: #94a3b8; -fx-font-size: 9px; -fx-font-weight: bold;"/>
                        <Label fx:id="lblTotalProjects" text="0" style="-fx-text-fill: #1a202c; -fx-font-weight: bold; -fx-font-size: 30px;"/>
                        <Label text="Projets" style="-fx-font-size: 12px; -fx-text-fill: #94a3b8; -fx-font-weight: bold;"/>
                        <Region prefHeight="4" style="-fx-background-color: linear-gradient(to right, #145EB7, #3FA9F5); -fx-background-radius: 2;"/>
                    </VBox>
                    <VBox spacing="6" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: white; -fx-border-radius: 12; -fx-background-radius: 12;
                                 -fx-border-color: #e2e8f0; -fx-border-width: 1; -fx-padding: 18;
                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);">
                        <Label text="ACTIFS" style="-fx-text-fill: #94a3b8; -fx-font-size: 9px; -fx-font-weight: bold;"/>
                        <Label fx:id="lblActiveProjects" text="0" style="-fx-text-fill: #16a34a; -fx-font-weight: bold; -fx-font-size: 30px;"/>
                        <Label text="En cours" style="-fx-font-size: 12px; -fx-text-fill: #94a3b8; -fx-font-weight: bold;"/>
                        <Region prefHeight="4" style="-fx-background-color: linear-gradient(to right, #22c55e, #14b8a6); -fx-background-radius: 2;"/>
                    </VBox>
                    <VBox spacing="6" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: white; -fx-border-radius: 12; -fx-background-radius: 12;
                                 -fx-border-color: #e2e8f0; -fx-border-width: 1; -fx-padding: 18;
                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);">
                        <Label text="EN RETARD" style="-fx-text-fill: #94a3b8; -fx-font-size: 9px; -fx-font-weight: bold;"/>
                        <Label fx:id="lblDelayedProjects" text="0" style="-fx-text-fill: #dc2626; -fx-font-weight: bold; -fx-font-size: 30px;"/>
                        <Label text="Retards" style="-fx-font-size: 12px; -fx-text-fill: #94a3b8; -fx-font-weight: bold;"/>
                        <Region prefHeight="4" style="-fx-background-color: linear-gradient(to right, #ef4444, #f97316); -fx-background-radius: 2;"/>
                    </VBox>
                    <VBox spacing="6" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: white; -fx-border-radius: 12; -fx-background-radius: 12;
                                 -fx-border-color: #e2e8f0; -fx-border-width: 1; -fx-padding: 18;
                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);">
                        <Label text="TERMINÉS" style="-fx-text-fill: #94a3b8; -fx-font-size: 9px; -fx-font-weight: bold;"/>
                        <Label fx:id="lblCompletedProjects" text="0" style="-fx-text-fill: #145EB7; -fx-font-weight: bold; -fx-font-size: 30px;"/>
                        <Label text="Finalisés" style="-fx-font-size: 12px; -fx-text-fill: #94a3b8; -fx-font-weight: bold;"/>
                        <Region prefHeight="4" style="-fx-background-color: linear-gradient(to right, #145EB7, #3FA9F5); -fx-background-radius: 2;"/>
                    </VBox>
                </HBox>

                <HBox spacing="16" alignment="CENTER">
                    <VBox alignment="CENTER" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: white; -fx-border-radius: 10; -fx-background-radius: 10;
                                 -fx-border-color: #e2e8f0; -fx-border-width: 1; -fx-padding: 12;
                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.04), 6, 0, 0, 1);">
                        <Label text="À RISQUE" style="-fx-font-size: 10px; -fx-text-fill: #94a3b8; -fx-font-weight: bold;"/>
                        <Label fx:id="lblAtRisk" text="0" style="-fx-font-weight: bold; -fx-text-fill: #d97706;"/>
                    </VBox>
                    <VBox alignment="CENTER" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: white; -fx-border-radius: 10; -fx-background-radius: 10;
                                 -fx-border-color: #e2e8f0; -fx-border-width: 1; -fx-padding: 12;
                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.04), 6, 0, 0, 1);">
                        <Label text="TAUX SUCCÈS" style="-fx-font-size: 10px; -fx-text-fill: #94a3b8; -fx-font-weight: bold;"/>
                        <Label fx:id="lblSuccessRate" text="0%" style="-fx-font-weight: bold; -fx-text-fill: #145EB7;"/>
                    </VBox>
                    <VBox alignment="CENTER" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: white; -fx-border-radius: 10; -fx-background-radius: 10;
                                 -fx-border-color: #e2e8f0; -fx-border-width: 1; -fx-padding: 12;
                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.04), 6, 0, 0, 1);">
                        <Label text="BUDGET UTILISÉ" style="-fx-font-size: 10px; -fx-text-fill: #94a3b8; -fx-font-weight: bold;"/>
                        <Label fx:id="lblBudgetUsage" text="0%" style="-fx-font-weight: bold; -fx-text-fill: #475569;"/>
                    </VBox>
                </HBox>
            </VBox>

            <HBox spacing="20">
                <VBox prefWidth="350" spacing="10"
                      style="-fx-background-color: white; -fx-border-radius: 12; -fx-background-radius: 12;
                             -fx-border-color: #e2e8f0; -fx-border-width: 1; -fx-padding: 20;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="🏆" style="-fx-font-size: 20px;"/>
                        <VBox>
                            <Label text="Top Performers" style="-fx-font-weight: bold; -fx-font-size: 15px; -fx-text-fill: #1e293b;"/>
                            <Label text="Basé sur les tâches closes" style="-fx-font-size: 11px; -fx-text-fill: #94a3b8;"/>
                        </VBox>
                    </HBox>
                    <Separator style="-fx-opacity: 0.5;"/>
                    <VBox fx:id="vboxTopPerformers" spacing="8" prefHeight="120"/>
                </VBox>

                <VBox HBox.hgrow="ALWAYS" spacing="15"
                      style="-fx-background-color: white; -fx-border-radius: 12; -fx-background-radius: 12;
                             -fx-border-color: #e2e8f0; -fx-border-width: 1; -fx-padding: 20;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);">
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <TextField fx:id="searchField" promptText="🔍 Rechercher un projet..." HBox.hgrow="ALWAYS" prefHeight="40"
                                   style="-fx-background-radius: 20; -fx-background-color: white; -fx-border-color: #e2e8f0; -fx-border-radius: 20;"/>
                        <Button text="🔄" onAction="#handleRefresh" prefHeight="40" prefWidth="40"
                                style="-fx-background-color: transparent; -fx-text-fill: #145EB7;
                                       -fx-background-radius: 20; -fx-cursor: hand; -fx-font-weight: bold;
                                       -fx-border-color: #145EB7; -fx-border-width: 1;"/>
                    </HBox>
                    <HBox spacing="15">
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <Label text="Statut" style="-fx-font-size: 11px; -fx-text-fill: #94a3b8; -fx-font-weight: bold;"/>
                            <ComboBox fx:id="filterStatus" maxWidth="Infinity" prefHeight="35"
                                      style="-fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-background-color: white;"/>
                        </VBox>
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <Label text="Priorité" style="-fx-font-size: 11px; -fx-text-fill: #94a3b8; -fx-font-weight: bold;"/>
                            <ComboBox fx:id="filterPriority" maxWidth="Infinity" prefHeight="35"
                                      style="-fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-background-color: white;"/>
                        </VBox>
                        <VBox alignment="BOTTOM_CENTER">
                            <Button fx:id="btnNewProject" text="+ Nouveau Projet" onAction="#handleNewProject" prefHeight="35"
                                    style="-fx-background-color: linear-gradient(to right, #145EB7, #3FA9F5);
                                           -fx-text-fill: white; -fx-background-radius: 8; -fx-font-weight: bold;
                                           -fx-padding: 0 20; -fx-cursor: hand;"/>
                        </VBox>
                    </HBox>
                </VBox>
            </HBox>

            <VBox VBox.vgrow="ALWAYS"
                  style="-fx-background-color: white; -fx-border-radius: 12; -fx-background-radius: 12;
                         -fx-border-color: #e2e8f0; -fx-border-width: 1; -fx-padding: 10;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);">
                <TableView fx:id="tableProjects" VBox.vgrow="ALWAYS" prefHeight="400" minHeight="350">
                    <columns>
                        <TableColumn fx:id="colId" text="ID" prefWidth="50"/>
                        <TableColumn fx:id="colName" text="Nom du Projet" prefWidth="220"/>
                        <TableColumn fx:id="colStatus" text="Statut" prefWidth="130"/>
                        <TableColumn fx:id="colPriority" text="Priorité" prefWidth="110"/>
                        <TableColumn fx:id="colProgress" text="Avancement" prefWidth="150"/>
                        <TableColumn fx:id="colEndDate" text="Date de fin" prefWidth="120"/>
                        <TableColumn fx:id="colCollabCount" text="Équipe" prefWidth="80"/>
                    </columns>
                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                </TableView>
            </VBox>

            <HBox spacing="15" alignment="CENTER_LEFT" style="-fx-padding: 5 0;">
                <Button fx:id="btnViewDetails" text="👁️ Voir détails" onAction="#handleViewDetails"
                        style="-fx-background-color: linear-gradient(to right, #145EB7, #3FA9F5);
                               -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 10 20;
                               -fx-font-weight: bold; -fx-cursor: hand;"/>

                <Button text="👥 Équipe" onAction="#handleManageTeam"
                        style="-fx-background-color: #f1f5f9; -fx-text-fill: #145EB7; -fx-background-radius: 8;
                               -fx-padding: 10 20; -fx-font-weight: bold; -fx-cursor: hand;
                               -fx-border-color: #145EB7; -fx-border-width: 1;"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Button text="📄 PDF" onAction="#handleQuickExportPDF"
                        style="-fx-background-color: white; -fx-text-fill: #475569; -fx-background-radius: 8;
                               -fx-padding: 10 20; -fx-font-weight: bold; -fx-border-color: #e2e8f0; -fx-border-width: 1;"/>

                <Button text="🔔 Alertes" onAction="#handleCheckAlerts"
                        style="-fx-background-color: white; -fx-text-fill: #475569; -fx-background-radius: 8;
                               -fx-padding: 10 20; -fx-font-weight: bold; -fx-border-color: #e2e8f0; -fx-border-width: 1;"/>

                <Button fx:id="btnEditProject" text="✏️ Modifier" onAction="#handleEditProject"
                        style="-fx-background-color: #f59e0b; -fx-text-fill: white; -fx-background-radius: 8;
                               -fx-padding: 10 20; -fx-font-weight: bold;"/>

                <Button fx:id="btnDeleteProject" text="🗑️ Supprimer" onAction="#handleDeleteProject"
                        style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-background-radius: 8;
                               -fx-padding: 10 20; -fx-font-weight: bold;"/>
            </HBox>

        </VBox>
    </VBox>
</ScrollPane>