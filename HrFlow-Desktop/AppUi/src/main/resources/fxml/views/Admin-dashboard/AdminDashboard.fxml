<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<BorderPane prefHeight="760.0" prefWidth="1440.0"
            style="-fx-background-color: #F5F7FA;"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.ui.controller.Admin.AdminDashboardController">

    <!-- ═══════════════════════════════════════════════════
         SIDEBAR  — deep slate, full height
    ════════════════════════════════════════════════════ -->
    <left>
        <VBox spacing="0"
              style="-fx-background-color: #0F172A;
                     -fx-min-width: 248; -fx-max-width: 248;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.35), 14, 0, 3, 0);">

            <!-- ── Brand ── -->
            <HBox alignment="CENTER_LEFT" spacing="12"
                  style="-fx-padding: 22 18 18 18; -fx-background-color: #0F172A;">
                <ImageView fitWidth="40" fitHeight="40" preserveRatio="true" smooth="true">
                    <image><Image url="@/logo.png"/></image>
                </ImageView>
                <VBox spacing="2">
                    <Label text="HR-Flow"
                           style="-fx-font-size: 19px; -fx-font-weight: bold;
                                  -fx-text-fill: #F8FAFC;"/>
                    <Label text="ADMINISTRATION"
                           style="-fx-font-size: 9px; -fx-text-fill: #3B82F6;
                                  -fx-font-weight: bold; -fx-letter-spacing: 1px;"/>
                </VBox>
            </HBox>

            <!-- Divider -->
            <Region style="-fx-background-color: #1E293B; -fx-min-height: 1; -fx-max-height: 1;"
                    maxWidth="Infinity"/>

            <!-- ── Section: Menu Principal ── -->
            <VBox spacing="2" style="-fx-padding: 18 10 6 10;">
                <Label text="MENU PRINCIPAL"
                       style="-fx-font-size: 9px; -fx-text-fill: #334155;
                              -fx-font-weight: bold; -fx-padding: 0 6 6 6;
                              -fx-letter-spacing: 1.5px;"/>

                <Button fx:id="homeBtn" text="🏠   Accueil"
                        maxWidth="Infinity" onAction="#showHome"
                        style="-fx-background-color: #1D4ED8;
                               -fx-text-fill: #FFFFFF;
                               -fx-background-radius: 8; -fx-border-radius: 8;
                               -fx-padding: 10 14; -fx-font-size: 13px;
                               -fx-font-weight: bold; -fx-cursor: hand;
                               -fx-alignment: CENTER_LEFT;
                               -fx-border-color: transparent; -fx-border-width: 0;"/>

                <Button fx:id="usersBtn" text="👥   Utilisateurs"
                        maxWidth="Infinity" onAction="#showUsers"
                        style="-fx-background-color: transparent;
                               -fx-text-fill: #94A3B8;
                               -fx-background-radius: 8; -fx-border-radius: 8;
                               -fx-padding: 10 14; -fx-font-size: 13px;
                               -fx-cursor: hand; -fx-alignment: CENTER_LEFT;
                               -fx-border-color: transparent; -fx-border-width: 0;"/>

                <Button fx:id="employeesBtn" text="🧑‍💼   Employés"
                        maxWidth="Infinity" onAction="#showEmployees"
                        style="-fx-background-color: transparent;
                               -fx-text-fill: #94A3B8;
                               -fx-background-radius: 8; -fx-border-radius: 8;
                               -fx-padding: 10 14; -fx-font-size: 13px;
                               -fx-cursor: hand; -fx-alignment: CENTER_LEFT;
                               -fx-border-color: transparent; -fx-border-width: 0;"/>

                <Button fx:id="statsBtn" text="📊   Statistiques"
                        maxWidth="Infinity" onAction="#showStatistics"
                        style="-fx-background-color: transparent;
                               -fx-text-fill: #94A3B8;
                               -fx-background-radius: 8; -fx-border-radius: 8;
                               -fx-padding: 10 14; -fx-font-size: 13px;
                               -fx-cursor: hand; -fx-alignment: CENTER_LEFT;
                               -fx-border-color: transparent; -fx-border-width: 0;"/>

                <Button fx:id="leaveExceptionsBtn" text="🚨   Congés Except."
                        maxWidth="Infinity" onAction="#showLeaveExceptions"
                        style="-fx-background-color: transparent;
                               -fx-text-fill: #94A3B8;
                               -fx-background-radius: 8; -fx-border-radius: 8;
                               -fx-padding: 10 14; -fx-font-size: 13px;
                               -fx-cursor: hand; -fx-alignment: CENTER_LEFT;
                               -fx-border-color: transparent; -fx-border-width: 0;"/>
            </VBox>

            <!-- Divider -->
            <Region style="-fx-background-color: #1E293B; -fx-min-height: 1; -fx-max-height: 1;
                           -fx-margin: 4 10 4 10;" maxWidth="Infinity"/>

            <!-- ── Section: Outils ── -->
            <VBox spacing="2" style="-fx-padding: 10 10 8 10;">
                <Label text="OUTILS"
                       style="-fx-font-size: 9px; -fx-text-fill: #334155;
                              -fx-font-weight: bold; -fx-padding: 4 6 6 6;
                              -fx-letter-spacing: 1.5px;"/>

                <Button fx:id="DataAnalysisBtn" text="🤖   Analyse IA"
                        maxWidth="Infinity" onAction="#showDataAnalysis"
                        style="-fx-background-color: transparent;
                               -fx-text-fill: #94A3B8;
                               -fx-background-radius: 8; -fx-border-radius: 8;
                               -fx-padding: 10 14; -fx-font-size: 13px;
                               -fx-cursor: hand; -fx-alignment: CENTER_LEFT;
                               -fx-border-color: transparent; -fx-border-width: 0;"/>

                <Button fx:id="settingsBtn" text="⚙️   Paramètres"
                        maxWidth="Infinity" onAction="#showSettings"
                        style="-fx-background-color: transparent;
                               -fx-text-fill: #94A3B8;
                               -fx-background-radius: 8; -fx-border-radius: 8;
                               -fx-padding: 10 14; -fx-font-size: 13px;
                               -fx-cursor: hand; -fx-alignment: CENTER_LEFT;
                               -fx-border-color: transparent; -fx-border-width: 0;"/>
            </VBox>

            <!-- Spacer -->
            <Region VBox.vgrow="ALWAYS"/>

            <!-- Divider -->
            <Region style="-fx-background-color: #1E293B; -fx-min-height: 1; -fx-max-height: 1;"
                    maxWidth="Infinity"/>

            <!-- ── Bottom User Card ── -->
            <HBox alignment="CENTER_LEFT" spacing="10"
                  style="-fx-padding: 14 16; -fx-background-color: #0A1120;
                         -fx-cursor: hand;">
                <StackPane style="-fx-background-color: #1E3A5F;
                                  -fx-background-radius: 22;
                                  -fx-min-width: 38; -fx-min-height: 38;
                                  -fx-max-width: 38; -fx-max-height: 38;">
                    <Label text="A"
                           style="-fx-text-fill: #93C5FD;
                                  -fx-font-size: 16px;
                                  -fx-font-weight: bold;"/>
                </StackPane>
                <VBox spacing="2" HBox.hgrow="ALWAYS">
                    <Label fx:id="sidebarUserLabel" text="Administrateur"
                           style="-fx-text-fill: #E2E8F0;
                                  -fx-font-size: 13px;
                                  -fx-font-weight: bold;"/>
                    <Label text="Super Admin"
                           style="-fx-text-fill: #3B82F6;
                                  -fx-font-size: 10px; -fx-font-weight: bold;"/>
                </VBox>
                <Label text="→"
                       style="-fx-text-fill: #334155; -fx-font-size: 14px;"/>
            </HBox>

        </VBox>
    </left>

    <!-- ═══════════════════════════════════════════════════
         MAIN CONTENT — white header + light grey body
    ════════════════════════════════════════════════════ -->
    <center>
        <VBox spacing="0" style="-fx-background-color: #F5F7FA;">

            <!-- ── TOP HEADER (white) ── -->
            <HBox alignment="CENTER_LEFT"
                  prefHeight="68"
                  style="-fx-background-color: #FFFFFF;
                         -fx-border-color: transparent transparent #E2E8F0 transparent;
                         -fx-border-width: 0 0 1.5 0;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);">
                <padding>
                    <Insets left="36" right="36"/>
                </padding>

                <!-- Page title area -->
                <VBox spacing="2" alignment="CENTER_LEFT">
                    <Label text="Tableau de bord"
                           style="-fx-font-size: 19px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #0F172A;"/>
                    <Label text="Bienvenue dans l'espace administration"
                           style="-fx-font-size: 11px;
                                  -fx-text-fill: #94A3B8;"/>
                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

                <!-- Notification bell -->
                <StackPane style="-fx-background-color: #F1F5F9;
                                  -fx-background-radius: 8;
                                  -fx-min-width: 38; -fx-min-height: 38;
                                  -fx-max-width: 38; -fx-max-height: 38;
                                  -fx-cursor: hand;
                                  -fx-border-color: #E2E8F0;
                                  -fx-border-radius: 8;
                                  -fx-border-width: 1;">
                    <Label text="🔔"
                           style="-fx-font-size: 15px;"/>
                </StackPane>

                <Region minWidth="12"/>

                <!-- User badge -->
                <HBox alignment="CENTER" spacing="9"
                      style="-fx-background-color: #F8FAFC;
                             -fx-background-radius: 10;
                             -fx-padding: 7 14;
                             -fx-border-color: #E2E8F0;
                             -fx-border-radius: 10;
                             -fx-border-width: 1;
                             -fx-cursor: hand;">
                    <StackPane style="-fx-background-color: #DBEAFE;
                                      -fx-background-radius: 14;
                                      -fx-min-width: 28; -fx-min-height: 28;
                                      -fx-max-width: 28; -fx-max-height: 28;">
                        <Label text="A"
                               style="-fx-text-fill: #2563EB;
                                      -fx-font-size: 12px;
                                      -fx-font-weight: bold;"/>
                    </StackPane>
                    <Label fx:id="welcomeLabel" text="Admin"
                           style="-fx-font-size: 13px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #1E293B;"/>
                    <Label text="▾"
                           style="-fx-font-size: 9px;
                                  -fx-text-fill: #94A3B8;"/>
                </HBox>

                <Region minWidth="12"/>

                <!-- Logout -->
                <Button onAction="#handleLogout" text="Déconnexion"
                        style="-fx-background-color: #FEF2F2;
                               -fx-text-fill: #DC2626;
                               -fx-background-radius: 8;
                               -fx-border-color: #FECACA;
                               -fx-border-radius: 8;
                               -fx-border-width: 1;
                               -fx-padding: 8 16;
                               -fx-font-size: 12px;
                               -fx-font-weight: bold;
                               -fx-cursor: hand;"/>
            </HBox>

            <!-- ── CONTENT AREA (light grey, scrollable) ── -->
            <ScrollPane fitToWidth="true" fitToHeight="true"
                        VBox.vgrow="ALWAYS"
                        style="-fx-background-color: transparent;
                               -fx-background: #F5F7FA;
                               -fx-border-color: transparent;
                               -fx-padding: 0;">
                <StackPane fx:id="contentArea"
                           style="-fx-background-color: #F5F7FA;
                                  -fx-padding: 32;">
                    <!-- Dynamic content loaded here -->
                </StackPane>
            </ScrollPane>

        </VBox>
    </center>

</BorderPane>
