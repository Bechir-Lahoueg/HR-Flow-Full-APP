<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane fitToWidth="true" fitToHeight="true" xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.ui.controller.Employee.EmployeeProjectKanbanController"
            style="-fx-background-color: #f4f7fb; -fx-background: #f4f7fb;">
    <VBox spacing="20" style="-fx-background-color: #f4f7fb; -fx-padding: 24;">

        <!-- Header projet -->
        <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 20; -fx-border-radius: 12; -fx-background-radius: 12; -fx-border-color: #e2e8f0;">
            <HBox alignment="CENTER_LEFT" spacing="20">
                <Label fx:id="lblProjectName" text="📋 Nom du Projet"
                       style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="🔄 Actualiser" onAction="#handleRefresh"
                        style="-fx-background-color: transparent; -fx-text-fill: #145EB7; -fx-padding: 8 16; -fx-border-color: #145EB7; -fx-border-radius: 6; -fx-cursor: hand; -fx-font-weight: bold;"/>
                <Button fx:id="btnBack" text="← Retour" onAction="#handleBack"
                        style="-fx-background-color: rgba(2,46,105,0.1); -fx-text-fill: #022E69; -fx-padding: 8 16; -fx-background-radius: 6; -fx-cursor: hand; -fx-font-weight: bold;"/>
            </HBox>

            <Separator/>

            <HBox spacing="30">
                <VBox spacing="5">
                    <Label fx:id="lblMyRole" text="Mon rôle: N/A" style="-fx-font-size: 13px; -fx-text-fill: #475569;"/>
                    <Label fx:id="lblMyHours" text="Mes heures: 0h" style="-fx-font-size: 13px; -fx-text-fill: #475569;"/>
                </VBox>
                <VBox spacing="5">
                    <Label fx:id="lblProgress" text="Avancement: 0%" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
                    <ProgressBar fx:id="progressBar" prefWidth="200" progress="0"/>
                    <Label fx:id="lblTaskStats" text="Mes tâches: 0/0 terminées" style="-fx-font-size: 13px; -fx-text-fill: #475569;"/>
                </VBox>
                <Separator orientation="VERTICAL" prefHeight="50"/>
                <VBox spacing="6" alignment="CENTER" style="-fx-background-color: #f8fafc; -fx-padding: 10; -fx-border-radius: 10; -fx-background-radius: 10; -fx-border-color: #e2e8f0;">
                    <Label fx:id="lblTimer" text="00:00:00" style="-fx-font-family: 'Monospaced'; -fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #ef4444;"/>
                    <HBox spacing="10">
                        <Button fx:id="btnStartTimer" text="▶" onAction="#handleStartTimer"
                                style="-fx-background-color: #22c55e; -fx-text-fill: white; -fx-background-radius: 6;"/>
                        <Button fx:id="btnStopTimer" text="■" onAction="#handleStopTimer"
                                style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-background-radius: 6;" disable="true"/>
                    </HBox>
                </VBox>
            </HBox>
        </VBox>

        <!-- Kanban Board -->
        <VBox spacing="15" style="-fx-background-color: white; -fx-padding: 20; -fx-border-radius: 12; -fx-background-radius: 12; -fx-border-color: #e2e8f0;">
            <Label text="✅ Mes Tâches - Kanban Board" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
            <Label text="💡 Glissez-déposez les tâches pour changer leur statut ou utilisez les boutons"
                   style="-fx-font-size: 12px; -fx-text-fill: #94a3b8;"/>

            <HBox spacing="15" VBox.vgrow="ALWAYS" style="-fx-min-height: 450;">
                <!-- TODO -->
                <VBox spacing="10" HBox.hgrow="ALWAYS"
                      style="-fx-background-color: #f8fafc; -fx-padding: 10; -fx-border-radius: 8; -fx-background-radius: 8; -fx-border-color: #e2e8f0;">
                    <Label text="📋 À FAIRE" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
                    <Separator/>
                    <ScrollPane fitToWidth="true" fitToHeight="true" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent;">
                        <VBox fx:id="kanbanTodo" spacing="10" style="-fx-padding: 5;" minHeight="500" />
                    </ScrollPane>
                </VBox>

                <!-- IN PROGRESS -->
                <VBox spacing="10" HBox.hgrow="ALWAYS"
                      style="-fx-background-color: #f8fafc; -fx-padding: 10; -fx-border-radius: 8; -fx-background-radius: 8; -fx-border-color: #e2e8f0;">
                    <Label text="⏳ EN COURS" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
                    <Separator/>
                    <ScrollPane fitToWidth="true" fitToHeight="true" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent;">
                        <VBox fx:id="kanbanInProgress" spacing="10" style="-fx-padding: 5;" minHeight="500" />
                    </ScrollPane>
                </VBox>

                <!-- REVIEW -->
                <VBox spacing="10" HBox.hgrow="ALWAYS"
                      style="-fx-background-color: #f8fafc; -fx-padding: 10; -fx-border-radius: 8; -fx-background-radius: 8; -fx-border-color: #e2e8f0;">
                    <Label text="👁️ REVIEW" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
                    <Separator/>
                    <ScrollPane fitToWidth="true" fitToHeight="true" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent;">
                        <VBox fx:id="kanbanReview" spacing="10" style="-fx-padding: 5;" minHeight="500" />
                    </ScrollPane>
                </VBox>

                <!-- DONE -->
                <VBox spacing="10" HBox.hgrow="ALWAYS"
                      style="-fx-background-color: #f8fafc; -fx-padding: 10; -fx-border-radius: 8; -fx-background-radius: 8; -fx-border-color: #e2e8f0;">
                    <Label text="✅ TERMINÉ" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
                    <Separator/>
                    <ScrollPane fitToWidth="true" fitToHeight="true" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent;">
                        <VBox fx:id="kanbanDone" spacing="10" style="-fx-padding: 5;" minHeight="500" />
                    </ScrollPane>
                </VBox>
            </HBox>
        </VBox>

        <!-- Activités -->
        <VBox spacing="15" style="-fx-background-color: white; -fx-padding: 20; -fx-border-radius: 12; -fx-background-radius: 12; -fx-border-color: #e2e8f0;">
            <Label text="📝 Activités du Projet" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>

            <ListView fx:id="listActivities" prefHeight="200"
                      style="-fx-border-color: #e2e8f0; -fx-border-radius: 8;"/>

            <VBox spacing="10" style="-fx-background-color: #f8fafc; -fx-padding: 15; -fx-border-radius: 8; -fx-background-radius: 8;">
                <Label text="💬 Ajouter un commentaire" style="-fx-font-weight: bold;"/>
                <TextArea fx:id="txtComment" promptText="Écrire un commentaire..." prefRowCount="2" style="-fx-border-color: #e2e8f0; -fx-border-radius: 6;"/>
                <HBox alignment="CENTER_RIGHT">
                    <Button text="✉️ Publier" onAction="#handleAddComment"
                            style="-fx-background-color: linear-gradient(to right, #145EB7, #3FA9F5); -fx-text-fill: white; -fx-padding: 8 20; -fx-background-radius: 8;"/>
                </HBox>
            </VBox>
        </VBox>

    </VBox>
</ScrollPane>

