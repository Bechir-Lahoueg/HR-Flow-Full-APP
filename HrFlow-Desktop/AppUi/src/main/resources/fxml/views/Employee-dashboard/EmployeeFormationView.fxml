<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane fitToWidth="true" fitToHeight="true" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.ui.controller.Employee.EmployeeFormationController"
            style="-fx-background-color: #f4f7fb; -fx-background: #f4f7fb;">
    <VBox spacing="16" style="-fx-background-color: #f4f7fb; -fx-padding: 20;">

        <HBox alignment="CENTER_LEFT" spacing="12"
              style="-fx-background-color: linear-gradient(to bottom right, #022E69, #0a3d8f, #051f3d); -fx-padding: 18 24; -fx-background-radius: 10;">
            <Label text="📚" style="-fx-font-size: 24px;"/>
            <Label text="Formations" style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 20px;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnRefresh" text="🔄 Actualiser" onAction="#handleRefresh"
                    style="-fx-background-color: rgba(255,255,255,0.12); -fx-text-fill: white; -fx-padding: 8 18; -fx-background-radius: 6; -fx-cursor: hand; -fx-font-weight: bold; -fx-border-color: rgba(255,255,255,0.35); -fx-border-width: 1;"/>
        </HBox>


        <HBox fx:id="tabNavBar" spacing="0" alignment="CENTER_LEFT"
              style="-fx-background-color: white; -fx-border-color: #e2e8f0; -fx-border-width: 0 0 2 0; -fx-padding: 0; -fx-background-radius: 10 10 0 0;">
            <Button fx:id="btnTabFormations" text="📋 Formations"
                    style="-fx-background-color: transparent; -fx-text-fill: #145EB7; -fx-padding: 16 20; -fx-cursor: hand; -fx-font-weight: bold; -fx-font-size: 13px; -fx-border-width: 0 0 3 0; -fx-border-color: #145EB7; -fx-border-radius: 0; -fx-effect: null;"
                    HBox.hgrow="NEVER"/>
            <Button fx:id="btnTabSessions" text="📅 Sessions"
                    style="-fx-background-color: transparent; -fx-text-fill: #a0aec0; -fx-padding: 16 20; -fx-cursor: hand; -fx-font-weight: bold; -fx-font-size: 13px; -fx-border-width: 0 0 3 0; -fx-border-color: transparent; -fx-border-radius: 0; -fx-effect: null;"
                    HBox.hgrow="NEVER"/>
            <Button fx:id="btnTabInscriptions" text="✅ Inscriptions"
                    style="-fx-background-color: transparent; -fx-text-fill: #a0aec0; -fx-padding: 16 20; -fx-cursor: hand; -fx-font-weight: bold; -fx-font-size: 13px; -fx-border-width: 0 0 3 0; -fx-border-color: transparent; -fx-border-radius: 0; -fx-effect: null;"
                    HBox.hgrow="NEVER"/>
            <Region HBox.hgrow="ALWAYS"/>
        </HBox>


        <StackPane fx:id="contentStackPane" VBox.vgrow="ALWAYS"
                   style="-fx-background-color: white; -fx-border-radius: 0 0 10 10; -fx-background-radius: 0 0 10 10; -fx-border-color: #e2e8f0; -fx-border-width: 0 1 1 1;">

            <!-- ==================== FORMATIONS CONTENT ==================== -->
            <VBox fx:id="formationsPanel" spacing="12" style="-fx-padding: 20;">
                <Label text="Parcourez toutes les formations disponibles" style="-fx-font-size: 12px; -fx-text-fill: #64748b; -fx-font-style: italic;"/>
                <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent;">
                    <VBox fx:id="vboxFormations" spacing="12" style="-fx-padding: 5;"/>
                </ScrollPane>
            </VBox>

            <!-- ==================== SESSIONS CONTENT ==================== -->
            <VBox fx:id="sessionsPanel" spacing="12" style="-fx-padding: 20; -fx-background-color: white;">
                <HBox spacing="12" alignment="CENTER_LEFT">
                    <Label text="Formation:" style="-fx-font-weight: bold; -fx-text-fill: #475569;"/>
                    <ComboBox fx:id="cbFormation" promptText="Sélectionnez une formation" prefWidth="350"
                              style="-fx-background-color: white; -fx-border-color: #e2e8f0; -fx-border-radius: 6;"/>
                </HBox>
                <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent;">
                    <VBox fx:id="vboxSessions" spacing="12" style="-fx-padding: 5;"/>
                </ScrollPane>
            </VBox>

            <!-- ==================== INSCRIPTIONS CONTENT ==================== -->
            <VBox fx:id="inscriptionsPanel" spacing="12" style="-fx-padding: 20; -fx-background-color: white;">
                <HBox spacing="12" alignment="CENTER_LEFT">
                    <Label text="Rechercher par formation:" style="-fx-font-weight: bold; -fx-text-fill: #475569;"/>
                    <TextField fx:id="searchInscriptions" promptText="Tapez le nom de la formation..." prefWidth="300"
                               style="-fx-background-color: white; -fx-border-color: #e2e8f0; -fx-border-radius: 6;"/>
                    <Button fx:id="btnRefreshInscriptions" text="🔄 Actualiser"
                            style="-fx-background-color: linear-gradient(to right, #145EB7, #3FA9F5); -fx-text-fill: white; -fx-padding: 8 18; -fx-background-radius: 6; -fx-cursor: hand;"/>
                </HBox>
                <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent;">
                    <VBox fx:id="vboxInscriptions" spacing="12" style="-fx-padding: 5;"/>
                </ScrollPane>
            </VBox>
        </StackPane>
    </VBox>
</ScrollPane>