<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<ScrollPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.ui.controller.Employee.Congé.EmployeeLeaveController"
            fitToWidth="true" fitToHeight="true"
            style="-fx-background-color: #f4f7fb; -fx-background: #f4f7fb;">

    <VBox spacing="16" style="-fx-background-color: #f4f7fb; -fx-padding: 20;">

        <!-- ══ HEADER ══ -->
        <HBox alignment="CENTER_LEFT" spacing="14"
              style="-fx-background-color: linear-gradient(to bottom right, #022E69, #0a3d8f, #051f3d);
                     -fx-padding: 18 24; -fx-background-radius: 12;">
            <Label text="🏖️" style="-fx-font-size: 26px;"/>
            <VBox spacing="2">
                <Label text="Gestion de mes Congés"
                       style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 20px;"/>
                <Label text="Planifiez et suivez vos demandes de congé"
                       style="-fx-text-fill: #94a3b8; -fx-font-size: 11px;"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <HBox spacing="6" alignment="CENTER"
                  style="-fx-background-color: rgba(255,255,255,0.12); -fx-padding: 6 14;
                         -fx-background-radius: 20; -fx-border-color: rgba(255,255,255,0.35);
                         -fx-border-width: 1; -fx-border-radius: 20;">
                <Label text="🟢" style="-fx-font-size: 10px;"/>
                <Label text="API Jours Fériés TN • Nager.Date"
                       style="-fx-text-fill: white; -fx-font-size: 11px; -fx-font-weight: bold;"/>
            </HBox>
        </HBox>

        <!-- ══ SOLDE ══ -->
        <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 16; -fx-background-radius: 12;
                                   -fx-border-color: #e2e8f0; -fx-border-width: 1;
                                   -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);">
            <HBox alignment="CENTER_LEFT" spacing="8">
                <Label text="💼" style="-fx-font-size: 16px;"/>
                <Label text="Mon Solde de Congés"
                       style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
            </HBox>
            <HBox spacing="12" alignment="CENTER">
                <VBox spacing="5" alignment="CENTER" HBox.hgrow="ALWAYS"
                      style="-fx-background-color: white; -fx-padding: 16; -fx-background-radius: 12;
                             -fx-border-color: #e2e8f0; -fx-border-width: 1; -fx-border-radius: 12;">
                    <Label text="🗓️" style="-fx-font-size: 26px;"/>
                    <Label text="Solde Disponible" style="-fx-font-weight: bold; -fx-font-size: 11px; -fx-text-fill: #64748b;"/>
                    <Label fx:id="balanceDaysLabel" text="-- j" style="-fx-font-weight: bold; -fx-font-size: 28px; -fx-text-fill: #145EB7;"/>
                    <Label text="jours restants" style="-fx-font-size: 10px; -fx-text-fill: #94a3b8;"/>
                </VBox>
                <VBox spacing="5" alignment="CENTER" HBox.hgrow="ALWAYS"
                      style="-fx-background-color: white; -fx-padding: 14; -fx-background-radius: 12;
                             -fx-border-color: #e2e8f0; -fx-border-width: 1; -fx-border-radius: 12;">
                    <Label text="📈" style="-fx-font-size: 22px;"/>
                    <Label text="Total Accumulé" style="-fx-font-weight: bold; -fx-font-size: 11px; -fx-text-fill: #64748b;"/>
                    <Label fx:id="totalAccruedLabel" text="--" style="-fx-font-weight: bold; -fx-font-size: 20px; -fx-text-fill: #16a34a;"/>
                    <Label text="jours gagnés" style="-fx-font-size: 10px; -fx-text-fill: #94a3b8;"/>
                </VBox>
                <VBox spacing="5" alignment="CENTER" HBox.hgrow="ALWAYS"
                      style="-fx-background-color: white; -fx-padding: 14; -fx-background-radius: 12;
                             -fx-border-color: #e2e8f0; -fx-border-width: 1; -fx-border-radius: 12;">
                    <Label text="📤" style="-fx-font-size: 22px;"/>
                    <Label text="Total Utilisé" style="-fx-font-weight: bold; -fx-font-size: 11px; -fx-text-fill: #64748b;"/>
                    <Label fx:id="totalUsedLabel" text="--" style="-fx-font-weight: bold; -fx-font-size: 20px; -fx-text-fill: #d97706;"/>
                    <Label text="jours consommés" style="-fx-font-size: 10px; -fx-text-fill: #94a3b8;"/>
                </VBox>
                <VBox spacing="5" alignment="CENTER" HBox.hgrow="ALWAYS"
                      style="-fx-background-color: white; -fx-padding: 14; -fx-background-radius: 12;
                             -fx-border-color: #e2e8f0; -fx-border-width: 1; -fx-border-radius: 12;">
                    <Label text="⏱️" style="-fx-font-size: 22px;"/>
                    <Label text="Prochaine Attribution" style="-fx-font-weight: bold; -fx-font-size: 11px; -fx-text-fill: #64748b;"/>
                    <Label fx:id="nextAccrualLabel" text="--" style="-fx-font-weight: bold; -fx-font-size: 13px; -fx-text-fill: #145EB7;"/>
                    <Label text="+1.8 jours/mois" style="-fx-font-size: 10px; -fx-text-fill: #94a3b8;"/>
                </VBox>
            </HBox>
            <!-- Progress Bar solde -->
            <VBox spacing="4">
                <HBox alignment="CENTER_LEFT">
                    <Label text="Progression du solde utilisé" style="-fx-font-size: 10px; -fx-text-fill: #94a3b8;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="balanceProgressLabel" text="" style="-fx-font-size: 10px; -fx-text-fill: #475569; -fx-font-weight: bold;"/>
                </HBox>
                <ProgressBar fx:id="balanceProgressBar" progress="0.0" prefWidth="10000" prefHeight="8"
                             style="-fx-accent: #145EB7; -fx-control-inner-background: #e2e8f0;"/>
            </VBox>
        </VBox>

        <!-- ══ STATS ══ -->
        <GridPane hgap="12" vgap="0">
            <columnConstraints>
                <ColumnConstraints percentWidth="33.33"/>
                <ColumnConstraints percentWidth="33.33"/>
                <ColumnConstraints percentWidth="33.33"/>
            </columnConstraints>
            <VBox spacing="6" alignment="CENTER" GridPane.columnIndex="0"
                  style="-fx-background-color: white; -fx-padding: 12; -fx-background-radius: 8;
                         -fx-border-color: #e2e8f0; -fx-border-width: 1; -fx-border-radius: 8;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 6, 0, 0, 2);">
                <Label text="📅" style="-fx-font-size: 22px;"/>
                <Label text="Congés Approuvés" style="-fx-font-weight: bold; -fx-font-size: 11px; -fx-text-fill: #64748b;"/>
                <Label fx:id="totalDaysLabel" text="0 jour(s)" style="-fx-font-weight: bold; -fx-font-size: 19px; -fx-text-fill: #145EB7;"/>
            </VBox>
            <VBox spacing="6" alignment="CENTER" GridPane.columnIndex="1"
                  style="-fx-background-color: white; -fx-padding: 12; -fx-background-radius: 8;
                         -fx-border-color: #e2e8f0; -fx-border-width: 1; -fx-border-radius: 8;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 6, 0, 0, 2);">
                <Label text="⏳" style="-fx-font-size: 22px;"/>
                <Label text="En Attente" style="-fx-font-weight: bold; -fx-font-size: 11px; -fx-text-fill: #64748b;"/>
                <Label fx:id="pendingRequestsLabel" text="0 demande(s)" style="-fx-font-weight: bold; -fx-font-size: 19px; -fx-text-fill: #d97706;"/>
            </VBox>
            <VBox spacing="6" alignment="CENTER" GridPane.columnIndex="2"
                  style="-fx-background-color: white; -fx-padding: 12; -fx-background-radius: 8;
                         -fx-border-color: #e2e8f0; -fx-border-width: 1; -fx-border-radius: 8;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 6, 0, 0, 2);">
                <Label text="✅" style="-fx-font-size: 22px;"/>
                <Label text="Acceptées" style="-fx-font-weight: bold; -fx-font-size: 11px; -fx-text-fill: #64748b;"/>
                <Label fx:id="acceptedRequestsLabel" text="0 demande(s)" style="-fx-font-weight: bold; -fx-font-size: 19px; -fx-text-fill: #16a34a;"/>
            </VBox>
        </GridPane>

        <!-- ══ FORMULAIRE (sous-vue déléguée) ══ -->
        <fx:include fx:id="leaveForm" source="EmployeeLeaveFormView.fxml"/>

        <!-- ══ HISTORIQUE (sous-vue déléguée) ══ -->
        <fx:include fx:id="leaveHistory" source="EmployeeLeaveHistoryView.fxml"/>

    </VBox>
</ScrollPane>
