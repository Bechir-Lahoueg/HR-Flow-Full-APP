<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.ui.controller.Employee.Congé.EmployeeLeaveFormController"
      spacing="14" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 12;
                           -fx-border-color: #e2e8f0; -fx-border-width: 1;
                           -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);">

    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label text="📝" style="-fx-font-size: 18px;"/>
        <Label text="Nouvelle Demande de Congé"
               style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <HBox spacing="5" alignment="CENTER"
              style="-fx-background-color: #eff6ff; -fx-padding: 4 10; -fx-background-radius: 12;
                     -fx-border-color: #145EB7; -fx-border-width: 1; -fx-border-radius: 12;">
            <Label text="🧮" style="-fx-font-size: 11px;"/>
            <Label text="Calculateur Intelligent Activé"
                   style="-fx-font-size: 10px; -fx-text-fill: #145EB7; -fx-font-weight: bold;"/>
        </HBox>
    </HBox>
    <Separator style="-fx-background-color: #e2e8f0;"/>

    <!-- Dates côte à côte -->
    <HBox spacing="12" alignment="CENTER">
        <VBox spacing="6" HBox.hgrow="ALWAYS">
            <HBox spacing="4" alignment="CENTER_LEFT">
                <Label text="📅" style="-fx-font-size: 13px;"/>
                <Label text="Date de début" style="-fx-font-weight: bold; -fx-text-fill: #475569; -fx-font-size: 12px;"/>
                <Label text=" *" style="-fx-text-fill: #ef4444; -fx-font-size: 12px;"/>
            </HBox>
            <DatePicker fx:id="startDatePicker" maxWidth="10000"
                       style="-fx-font-size: 13px; -fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-border-width: 1;"/>
        </VBox>
        <VBox alignment="BOTTOM_CENTER" style="-fx-padding: 0 0 6 0;">
            <Label text="→" style="-fx-font-size: 22px; -fx-text-fill: #145EB7; -fx-font-weight: bold;"/>
        </VBox>
        <VBox spacing="6" HBox.hgrow="ALWAYS">
            <HBox spacing="4" alignment="CENTER_LEFT">
                <Label text="📅" style="-fx-font-size: 13px;"/>
                <Label text="Date de fin" style="-fx-font-weight: bold; -fx-text-fill: #475569; -fx-font-size: 12px;"/>
                <Label text=" *" style="-fx-text-fill: #ef4444; -fx-font-size: 12px;"/>
            </HBox>
            <DatePicker fx:id="endDatePicker" maxWidth="10000"
                       style="-fx-font-size: 13px; -fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-border-width: 1;"/>
        </VBox>
    </HBox>

    <!-- Type de congé -->
    <VBox spacing="6">
        <HBox spacing="4" alignment="CENTER_LEFT">
            <Label text="🏷️" style="-fx-font-size: 13px;"/>
            <Label text="Type de congé" style="-fx-font-weight: bold; -fx-text-fill: #475569; -fx-font-size: 12px;"/>
            <Label text=" *" style="-fx-text-fill: #ef4444; -fx-font-size: 12px;"/>
        </HBox>
        <ComboBox fx:id="leaveTypeComboBox" maxWidth="10000"
                 style="-fx-font-size: 12px; -fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-border-width: 1;"/>
    </VBox>

    <!-- ══ MODE DE DEMANDE ══ -->
    <VBox spacing="6" style="-fx-background-color: #f8fafc; -fx-background-radius: 10; -fx-border-color: #e2e8f0; -fx-border-width: 1; -fx-border-radius: 10; -fx-padding: 12 14;">
        <HBox spacing="8" alignment="CENTER_LEFT">
            <Label text="📋" style="-fx-font-size: 14px;"/>
            <Label text="Mode de demande" style="-fx-font-weight: bold; -fx-text-fill: #145EB7; -fx-font-size: 12px;"/>
        </HBox>
        <HBox spacing="20" alignment="CENTER_LEFT">
            <RadioButton fx:id="normalModeRadio" text="🟢 Normale" selected="true"
                         style="-fx-font-size: 12px; -fx-text-fill: #16a34a;"/>
            <RadioButton fx:id="exceptionModeRadio" text="🔴 Exceptionnelle"
                         style="-fx-font-size: 12px; -fx-text-fill: #ef4444;"/>
        </HBox>
        <Label fx:id="balanceWarningLabel" text="" wrapText="true" managed="false" visible="false"
               style="-fx-text-fill: #b45309; -fx-font-size: 11px; -fx-background-color: #fff7ed; -fx-padding: 6 10; -fx-background-radius: 6;"/>
    </VBox>

    <!-- ══ PANNEAU EXCEPTIONNEL ══ -->
    <VBox fx:id="exceptionPanel" spacing="8" managed="false" visible="false"
          style="-fx-background-color: #fff5f5; -fx-background-radius: 10; -fx-border-color: #fecaca; -fx-border-width: 1; -fx-border-radius: 10; -fx-padding: 12 14;">
        <HBox spacing="8" alignment="CENTER_LEFT">
            <Label text="🚨" style="-fx-font-size: 14px;"/>
            <Label text="Options Demande Exceptionnelle"
                   style="-fx-font-weight: bold; -fx-text-fill: #b91c1c; -fx-font-size: 12px;"/>
        </HBox>
        <VBox spacing="6">
            <HBox spacing="4" alignment="CENTER_LEFT">
                <Label text="⚡" style="-fx-font-size: 13px;"/>
                <Label text="Niveau d'urgence" style="-fx-font-weight: bold; -fx-text-fill: #475569; -fx-font-size: 12px;"/>
                <Label text=" *" style="-fx-text-fill: #ef4444; -fx-font-size: 12px;"/>
            </HBox>
            <ComboBox fx:id="urgencyComboBox" maxWidth="10000"
                      style="-fx-font-size: 12px; -fx-border-color: #fecaca; -fx-border-radius: 8; -fx-border-width: 1;"/>
        </VBox>
        <HBox spacing="8" alignment="CENTER_LEFT">
            <Label text="💡" style="-fx-font-size: 11px;"/>
            <Label text="La justification détaillée est obligatoire (min. 15 caractères). Utilisez l'IA pour vous aider."
                   style="-fx-font-size: 10px; -fx-text-fill: #64748b;" wrapText="true" HBox.hgrow="ALWAYS"/>
        </HBox>
        <Button fx:id="aiJustificationButton" text="🤖 Générer une justification IA"
                style="-fx-background-color: linear-gradient(to right, #145EB7, #3FA9F5); -fx-text-fill: white;
                       -fx-font-size: 11px; -fx-font-weight: bold; -fx-padding: 7 16; -fx-background-radius: 8; -fx-cursor: hand;"/>
    </VBox>


    <VBox spacing="0"
          style="-fx-background-color: #f8fafc; -fx-background-radius: 10;
                 -fx-border-color: #e2e8f0; -fx-border-width: 1; -fx-border-radius: 10;">
        <HBox alignment="CENTER_LEFT" spacing="8"
              style="-fx-padding: 10 14; -fx-background-color: linear-gradient(to right, #145EB7, #3FA9F5);
                     -fx-background-radius: 8 8 0 0;">
            <Label text="🧮" style="-fx-font-size: 14px;"/>
            <Label text="Analyse Intelligente de la Période"
                   style="-fx-font-weight: bold; -fx-font-size: 12px; -fx-text-fill: white;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <HBox spacing="4" alignment="CENTER"
                  style="-fx-background-color: rgba(255,255,255,0.2); -fx-padding: 3 8; -fx-background-radius: 10;">
                <Label text="🇹🇳" style="-fx-font-size: 10px;"/>
                <Label text="Nager.Date API" style="-fx-font-size: 9px; -fx-text-fill: rgba(255,255,255,0.9);"/>
            </HBox>
        </HBox>
        <HBox>
            <VBox spacing="4" alignment="CENTER" HBox.hgrow="ALWAYS"
                  style="-fx-padding: 14 8; -fx-border-color: transparent #e2e8f0 transparent transparent; -fx-border-width: 0 1 0 0;">
                <Label text="📋" style="-fx-font-size: 20px;"/>
                <Label fx:id="daysCountLabel" text="--"
                       style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #145EB7;"/>
                <Label text="jours ouvrables" style="-fx-font-size: 10px; -fx-text-fill: #64748b;"/>
                <Label text="décomptés du solde" style="-fx-font-size: 9px; -fx-text-fill: #94a3b8;"/>
            </VBox>
            <VBox spacing="4" alignment="CENTER" HBox.hgrow="ALWAYS"
                  style="-fx-padding: 14 8; -fx-border-color: transparent #e2e8f0 transparent transparent; -fx-border-width: 0 1 0 0;">
                <Label text="🗓️" style="-fx-font-size: 20px;"/>
                <Label fx:id="calendarDaysLabel" text="--"
                       style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #475569;"/>
                <Label text="jours calendaires" style="-fx-font-size: 10px; -fx-text-fill: #64748b;"/>
                <Label text="durée réelle" style="-fx-font-size: 9px; -fx-text-fill: #94a3b8;"/>
            </VBox>
            <VBox spacing="4" alignment="CENTER" HBox.hgrow="ALWAYS"
                  style="-fx-padding: 14 8;">
                <Label text="🚫" style="-fx-font-size: 20px;"/>
                <Label fx:id="weekendDaysLabel" text="--"
                       style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #64748b;"/>
                <Label text="WE + fériés exclus" style="-fx-font-size: 10px; -fx-text-fill: #64748b;"/>
                <Label text="non comptabilisés" style="-fx-font-size: 9px; -fx-text-fill: #94a3b8;"/>
            </VBox>
        </HBox>
        <HBox alignment="CENTER" spacing="6"
              style="-fx-background-color: #f1f5f9; -fx-padding: 7 14; -fx-background-radius: 0 0 8 8;">
            <Label text="💡" style="-fx-font-size: 11px;"/>
            <Label text="Weekends et jours fériés tunisiens exclus automatiquement via l'API temps réel"
                   style="-fx-font-size: 10px; -fx-text-fill: #64748b;" wrapText="true"/>
        </HBox>
    </VBox>

    <!-- ══ ALERTE JOURS FÉRIÉS ══ -->
    <VBox fx:id="holidayWarningBox" spacing="0" managed="false" visible="false"
          style="-fx-background-radius: 10; -fx-border-color: #fecaca; -fx-border-width: 1.5; -fx-border-radius: 10;
                 -fx-effect: dropshadow(gaussian, rgba(239,68,68,0.3), 10, 0, 0, 3);">
        <HBox spacing="8" alignment="CENTER_LEFT"
              style="-fx-background-color: linear-gradient(to right, #ef4444, #f87171);
                     -fx-padding: 10 14; -fx-background-radius: 8 8 0 0;">
            <Label text="🚨" style="-fx-font-size: 16px;"/>
            <Label text="Jours fériés détectés — Demande bloquée"
                   style="-fx-font-weight: bold; -fx-font-size: 13px; -fx-text-fill: white;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="🇹🇳 Tunisie" style="-fx-font-size: 11px; -fx-text-fill: rgba(255,255,255,0.85);"/>
        </HBox>
        <VBox spacing="4" style="-fx-background-color: #fff5f5; -fx-padding: 12 14;">
            <Label fx:id="holidayListLabel" text=""
                   style="-fx-text-fill: #7f1d1d; -fx-font-size: 12px;" wrapText="true"/>
        </VBox>
        <HBox spacing="6" alignment="CENTER_LEFT"
              style="-fx-background-color: #fee2e2; -fx-padding: 8 14; -fx-background-radius: 0 0 8 8;">
            <Label text="⛔" style="-fx-font-size: 12px;"/>
            <Label text="Les demandes incluant un jour férié sont automatiquement rejetées. Veuillez choisir d'autres dates."
                   style="-fx-text-fill: #b91c1c; -fx-font-size: 11px; -fx-font-style: italic;" wrapText="true"/>
        </HBox>
    </VBox>

    <!-- ══ ALERTE AUCUN JOUR OUVRABLE ══ -->
    <VBox fx:id="noWorkingDaysBox" spacing="0" managed="false" visible="false"
          style="-fx-background-radius: 10; -fx-border-color: #fdba74; -fx-border-width: 1.5; -fx-border-radius: 10;
                 -fx-effect: dropshadow(gaussian, rgba(249,115,22,0.3), 10, 0, 0, 3);">
        <HBox spacing="8" alignment="CENTER_LEFT"
              style="-fx-background-color: linear-gradient(to right, #f59e0b, #fb923c);
                     -fx-padding: 10 14; -fx-background-radius: 8 8 0 0;">
            <Label text="⚠️" style="-fx-font-size: 16px;"/>
            <Label text="Période sans jour ouvrable"
                   style="-fx-font-weight: bold; -fx-font-size: 13px; -fx-text-fill: white;"/>
        </HBox>
        <HBox spacing="6" alignment="CENTER_LEFT"
              style="-fx-background-color: #fff7ed; -fx-padding: 10 14; -fx-background-radius: 0 0 8 8;">
            <Label text="🗓️" style="-fx-font-size: 13px;"/>
            <Label text="La période ne contient que des week-ends ou des jours fériés. Veuillez choisir une autre période."
                   style="-fx-text-fill: #7c2d12; -fx-font-size: 11px;" wrapText="true"/>
        </HBox>
    </VBox>

    <!-- Motif -->
    <VBox spacing="6">
        <HBox spacing="4" alignment="CENTER_LEFT">
            <Label text="💬" style="-fx-font-size: 13px;"/>
            <Label text="Motif / Raison" style="-fx-font-weight: bold; -fx-text-fill: #475569; -fx-font-size: 12px;"/>
            <Label text=" (optionnel)" style="-fx-text-fill: #94a3b8; -fx-font-size: 10px;"/>
        </HBox>
        <TextArea fx:id="reasonTextArea" prefRowCount="2" wrapText="true"
                 promptText="Décrivez le motif de votre demande de congé..."
                 style="-fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-border-width: 1; -fx-padding: 8; -fx-font-size: 12px;"/>
    </VBox>

    <!-- Boutons -->
    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button fx:id="clearButton" text="🔄 Réinitialiser"
                style="-fx-background-color: #f1f5f9; -fx-text-fill: #475569; -fx-font-size: 12px;
                       -fx-font-weight: bold; -fx-padding: 9 20; -fx-background-radius: 8; -fx-cursor: hand;
                       -fx-border-color: #e2e8f0;"/>
        <Button fx:id="submitButton" text="✅ Soumettre la Demande"
                style="-fx-background-color: linear-gradient(to right, #145EB7, #3FA9F5);
                       -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold;
                       -fx-padding: 9 24; -fx-background-radius: 8; -fx-cursor: hand;
                       -fx-effect: dropshadow(gaussian, rgba(20,94,183,0.35), 6, 0, 0, 2);"/>
    </HBox>

    <!-- Note info -->
    <HBox spacing="6" alignment="CENTER_LEFT"
          style="-fx-background-color: #eff6ff; -fx-padding: 8 12; -fx-background-radius: 8;
                 -fx-border-color: #145EB7; -fx-border-width: 1; -fx-border-radius: 8;">
        <Label text="ℹ️" style="-fx-font-size: 13px;"/>
        <Label text="Les champs * sont obligatoires. Le calcul exclut weekends et jours fériés tunisiens via l'API temps réel."
               style="-fx-text-fill: #145EB7; -fx-font-size: 11px;" wrapText="true"/>
    </HBox>
</VBox>
