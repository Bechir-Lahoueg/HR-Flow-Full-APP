<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane fitToWidth="true" fitToHeight="true" xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.ui.controller.Employee.EmployeeProjectController"
            style="-fx-background-color: #f4f7fb; -fx-background: #f4f7fb;">

    <VBox spacing="20" style="-fx-padding: 20; -fx-background-color: #f4f7fb;">

        <HBox alignment="CENTER_LEFT" spacing="12"
              style="-fx-background-color: linear-gradient(to bottom right, #022E69, #0a3d8f, #051f3d); -fx-padding: 18 24; -fx-background-radius: 10;">
            <Label text="🎯" style="-fx-font-size: 24px;"/>
            <VBox>
                <Label text="Mes Projets" style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 20px;"/>
                <Label text="Suivi de vos objectifs et tâches" style="-fx-text-fill: #94a3b8; -fx-font-size: 11px;"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="backButton" text="← Retour" onAction="#handleBackToDashboard"
                    style="-fx-background-color: rgba(255,255,255,0.12); -fx-text-fill: white; -fx-padding: 8 18; -fx-background-radius: 6; -fx-cursor: hand; -fx-font-weight: bold; -fx-border-color: rgba(255,255,255,0.35); -fx-border-width: 1;"/>
        </HBox>

        <HBox spacing="15" alignment="CENTER">
            <VBox alignment="CENTER" HBox.hgrow="ALWAYS"
                  style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 12; -fx-border-color: #e2e8f0; -fx-border-radius: 12;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);">
                <Label text="Mes projets" style="-fx-text-fill: #94a3b8; -fx-font-size: 12px;"/>
                <Label fx:id="lblMyProjects" text="0" style="-fx-text-fill: #145EB7; -fx-font-weight: bold; -fx-font-size: 20px;"/>
                <Region prefHeight="4" style="-fx-background-color: linear-gradient(to right, #145EB7, #3FA9F5); -fx-background-radius: 2;"/>
            </VBox>
            <VBox alignment="CENTER" HBox.hgrow="ALWAYS"
                  style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 12; -fx-border-color: #e2e8f0; -fx-border-radius: 12;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);">
                <Label text="Mes tâches" style="-fx-text-fill: #94a3b8; -fx-font-size: 12px;"/>
                <Label fx:id="lblMyTasks" text="0" style="-fx-text-fill: #d97706; -fx-font-weight: bold; -fx-font-size: 20px;"/>
                <Region prefHeight="4" style="-fx-background-color: linear-gradient(to right, #f59e0b, #fb923c); -fx-background-radius: 2;"/>
            </VBox>
            <VBox alignment="CENTER" HBox.hgrow="ALWAYS"
                  style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 12; -fx-border-color: #e2e8f0; -fx-border-radius: 12;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);">
                <Label text="Total heures" style="-fx-text-fill: #94a3b8; -fx-font-size: 12px;"/>
                <Label fx:id="lblMyHours" text="0h" style="-fx-text-fill: #16a34a; -fx-font-weight: bold; -fx-font-size: 20px;"/>
                <Region prefHeight="4" style="-fx-background-color: linear-gradient(to right, #22c55e, #14b8a6); -fx-background-radius: 2;"/>
            </VBox>
        </HBox>

        <VBox spacing="15"
              style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 12; -fx-border-color: #e2e8f0; -fx-border-radius: 12;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);">
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="📋" style="-fx-font-size: 18px; -fx-text-fill: #145EB7;"/>
                <Label text="Mes Projets Actifs" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
            </HBox>

            <TableView fx:id="tableMyProjects" prefHeight="200" minHeight="180">
                <columns>
                    <TableColumn fx:id="colProjectName" text="Projet" prefWidth="200"/>
                    <TableColumn fx:id="colProjectStatus" text="Statut" prefWidth="120"/>
                    <TableColumn fx:id="colMyRole" text="Mon rôle" prefWidth="150"/>
                    <TableColumn fx:id="colProgress" text="Avancement" prefWidth="150"/>
                    <TableColumn fx:id="colMyHours" text="Heures" prefWidth="100"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>
        </VBox>

        <VBox spacing="15" VBox.vgrow="ALWAYS"
              style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 12; -fx-border-color: #e2e8f0; -fx-border-radius: 12;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);">
            <HBox alignment="CENTER_LEFT" spacing="12">
                <Label text="✅" style="-fx-font-size: 18px; -fx-text-fill: #16a34a;"/>
                <Label text="Mes Tâches" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="Statut:" style="-fx-text-fill: #475569; -fx-font-weight: bold;"/>
                <ComboBox fx:id="filterTaskStatus" prefWidth="150" prefHeight="35" promptText="Tous les statuts"
                          style="-fx-background-color: white; -fx-border-color: #e2e8f0; -fx-border-radius: 6;"/>
                <Button text="🔄 Actualiser" onAction="#handleRefresh"
                        style="-fx-background-color: transparent; -fx-text-fill: #145EB7; -fx-border-color: #145EB7; -fx-border-radius: 6; -fx-padding: 6 15; -fx-cursor: hand; -fx-font-weight: bold;"/>
            </HBox>

            <TableView fx:id="tableMyTasks" VBox.vgrow="ALWAYS" minHeight="400">
                <columns>
                    <TableColumn fx:id="colTaskProject" text="Projet" prefWidth="150"/>
                    <TableColumn fx:id="colTaskTitle" text="Tâche" prefWidth="250"/>
                    <TableColumn fx:id="colTaskStatus" text="Statut" prefWidth="130"/>
                    <TableColumn fx:id="colTaskPriority" text="Priorité" prefWidth="110"/>
                    <TableColumn fx:id="colTaskDue" text="Échéance" prefWidth="150"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>

            <HBox spacing="12" alignment="CENTER_LEFT">
                <Button fx:id="btnViewTaskDetails" text="👁️ Voir détails" onAction="#handleViewTaskDetails"
                        style="-fx-background-color: #f1f5f9; -fx-text-fill: #1e293b; -fx-padding: 10 20; -fx-background-radius: 8; -fx-cursor: hand; -fx-font-weight: bold; -fx-border-color: #e2e8f0;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="btnLogHours" text="⏱️ Logger des heures" onAction="#handleLogHours"
                        style="-fx-background-color: linear-gradient(to right, #145EB7, #3FA9F5); -fx-text-fill: white; -fx-padding: 10 25; -fx-background-radius: 8; -fx-cursor: hand; -fx-font-weight: bold;
                               -fx-effect: dropshadow(gaussian, rgba(20,94,183,0.35), 6, 0, 0, 2);"/>
            </HBox>
        </VBox>

    </VBox>
</ScrollPane>

