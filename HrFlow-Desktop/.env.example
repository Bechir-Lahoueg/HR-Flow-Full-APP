# ============================================================================
# HrFlow-Desktop — Environment variable template
# Copy this file to ".env" and fill in REAL values locally (or export them in
# your shell). NEVER commit your real .env — it contains secrets.
#
# The desktop modules read these via System.getenv(...). The AiServices module
# can alternatively read them from src/main/resources/config.properties
# (keys: db.url, db.user, db.password, gemini.api.key, groq.api.key, llm.provider).
# That config.properties file is git-ignored and must not be committed.
# ============================================================================

# ---- Database (MySQL via JDBC) ----
# JDBC connection URL
DB_URL=jdbc:mysql://localhost:3306/hrflow?useSSL=true&requireSSL=true
# Database username (SECRET)
DB_USER=your_db_user
# Database password (SECRET)
DB_PASSWORD=your_db_password

# ---- AI / LLM providers ----
# Google Gemini API key (SECRET) — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIza_XXXXXXXXXXXXXXXXXXXXXXXXXXXX
# Groq API key (SECRET) — https://console.groq.com/keys
GROQ_API_KEY=gsk_XXXXXXXXXXXXXXXXXXXXXXXXXXXX
# Which LLM provider the AI agents use: gemini | groq
LLM_PROVIDER=gemini
