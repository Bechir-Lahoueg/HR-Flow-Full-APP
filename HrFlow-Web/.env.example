# ============================================================================
# HrFlow-Web — Environment variable template
# Copy this file to ".env" (or ".env.local") and fill in REAL values locally.
# NEVER commit your real .env — it contains secrets.
# ============================================================================

###> symfony/framework-bundle ###
# Symfony environment: dev | prod | test
APP_ENV=dev
# Secret used for CSRF tokens & signing — generate a random 32+ char hex string
APP_SECRET=change_me_to_a_random_secret
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
# MySQL connection DSN: mysql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL="mysql://user:password@localhost:3306/hrflow?serverVersion=8.0&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
# Async transport for Symfony Messenger (Doctrine by default)
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> symfony/mailer ###
# SMTP DSN for outgoing mail: smtp://USER:PASSWORD@HOST:PORT
MAILER_DSN=smtp://user%40example.com:your_smtp_password@smtp.example.com:587
# Default "from" address
MAILER_FROM=no-reply@example.com
###< symfony/mailer ###

###> hrflow/matrix-chat ###
# Matrix homeserver URL for chat integration
MATRIX_CLIENT_URL=https://matrix.org
# Matrix bot access token (SECRET)
MATRIX_ACCESS_TOKEN=mat_XXXXXXXXXXXXXXXXXXXXXXXXXXXX
# Matrix bot user id
MATRIX_BOT_USER_ID=@your_bot:matrix.org
###< hrflow/matrix-chat ###

###> hrflow/huggingface-emotion ###
# HuggingFace inference API token (SECRET) — get one at https://huggingface.co/settings/tokens
HUGGINGFACE_API_TOKEN=hf_XXXXXXXXXXXXXXXXXXXXXXXXXXXX
# HuggingFace model used for emotion detection
HUGGINGFACE_EMOTION_MODEL=bhadresh-savani/distilbert-base-uncased-emotion
###< hrflow/huggingface-emotion ###

# Public base URL of the app (used for absolute links / webhooks)
APP_PUBLIC_URL="http://localhost:8000"

# CORS: comma-separated list of allowed origins
CORS_ALLOW_ORIGINS=http://localhost:8000,https://127.0.0.1:8000

###> custom ###
# Relative directory where uploaded CVs are stored
UPLOAD_DIR=/uploads/cv/
###< custom ###

###> hrflow/external-apis ###
# OpenWeather API key (SECRET) — https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_api_key_here
# NewsAPI key (SECRET) — https://newsapi.org
NEWS_API_KEY=your_newsapi_key_here
###< hrflow/external-apis ###

###> google/gemini-api ###
# Google Gemini API key (SECRET) — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIza_XXXXXXXXXXXXXXXXXXXXXXXXXXXX
# OpenRouter API key (SECRET) — https://openrouter.ai/keys
OPEN_ROUTER_KEY=sk-or-v1-XXXXXXXXXXXXXXXXXXXXXXXXXXXX
###< google/gemini-api ###

# Toggle automatic recruitment e-mails: true | false
RECRUITMENT_EMAILS_ENABLED=false

###> hrflow/groq ###
# Groq API key (SECRET) — https://console.groq.com/keys
GROQ_API_KEY=gsk_XXXXXXXXXXXXXXXXXXXXXXXXXXXX
###< hrflow/groq ###

###> hrflow/nvidia ###
# NVIDIA NIM API key (SECRET) — https://build.nvidia.com
NVIDIA_API_KEY=nvapi-XXXXXXXXXXXXXXXXXXXXXXXXXXXX
# Secondary Groq API key (SECRET)
GROQ_API=gsk_XXXXXXXXXXXXXXXXXXXXXXXXXXXX
###< hrflow/nvidia ###

###> hrflow/churn ###
# URL of the local churn-prediction microservice
CHURN_API_URL=http://127.0.0.1:8001/predict
###< hrflow/churn ###

###> quickchart/api ###
# Toggle QuickChart chart rendering: true | false
QUICKCHART_ENABLED=true
###< quickchart/api ###
